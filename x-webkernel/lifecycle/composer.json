{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "webkernel/lifecycle",
    "description": "Composer plugin: Webkernel install paths and boot file (webapp_root, vendor_dir, instance_id, classmap).",
    "version": "0.12.0",
    "homepage": "https://www.webkernelphp.com",
    "type": "composer-plugin",
    "license": "proprietary",
    "authors": [
        {
            "name": "El Moumen Yassine",
            "email": "yassine@numerimondes.com",
            "homepage": "https://webkernelphp.com/about"
        }
    ],
    "require": {
        "php": ">=8.4",
        "composer-plugin-api": "^2.0",
        "composer/installers": "^2.0",
        "webkernel/codebase": "^0.12.0"
    },
    "require-dev": {
        "composer/composer": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Webkernel\\Lifecycle\\": "src/"
        },
        "files": [
            "load.lifecycle.package-function.php"
        ]
    },
    "extra": {
        "class": "Webkernel\\Lifecycle\\LCInstaller",
        "plugin-modifies-install-path": true,
        "webkernel": {
            "package_repo": "git@github.com:webkernelphp/lifecycle.git",
            "production": true,
            "prefix": "lifecycle"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
