{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "webkernel/views",
    "description": "Compile-once PHP templating. No Laravel.",
    "type": "library",
    "license": "EPL-2.0",
    "version": "0.12.0",
    "require": {
        "php": ">=8.4"
    },
    "autoload": {
        "psr-4": {
            "Webkernel\\Views\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "extra": {
        "webkernel": {
            "prefix": "views"
        }
    }
}
