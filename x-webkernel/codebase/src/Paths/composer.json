{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "webkernel/paths",
    "description": "Zero-dependency host path helpers (webapp_path, vendor_dir).",
    "type": "library",
    "license": "EPL-2.0",
    "version": "0.12.0",
    "require": {
        "php": ">=8.4"
    },
    "autoload": {
        "psr-4": {
            "Webkernel\\Paths\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "extra": {
        "webkernel": {
            "prefix": "paths"
        }
    }
}
