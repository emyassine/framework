{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "webkernel/route",
    "description": "HTTP router. FastRoute MarkBased engine, owned in-tree.",
    "type": "library",
    "license": "proprietary",
    "version": "0.12.0",
    "require": {
        "php": ">=8.4"
    },
    "autoload": {
        "psr-4": {
            "Webkernel\\Route\\": "src/"
        },
        "files": [
            "load.route.package-function.php"
        ]
    },
    "extra": {
        "webkernel": {
            "prefix": "route"
        }
    }
}
