{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "webkernel/codebase",
    "description": "Webkernel runtime: paths, instance, views. Zero runtime package dependencies.",
    "type": "library",
    "license": "EPL-2.0",
    "version": "0.12.0",
    "autoload": {
        "files": [
            "src/namespacer.php",
            "src/Paths/src/functions.php",
            "src/Instance/src/functions.php",
            "src/Views/src/functions.php"
        ],
        "classmap": [
            "src/WebApp.php"
        ],
        "psr-4": {
            "Webkernel\\Paths\\": "src/Paths/src/",
            "Webkernel\\Instance\\": "src/Instance/src/",
            "Webkernel\\Views\\": "src/Views/src/",
            "Webkernel\\DevEnv\\": "src/DevEnv/src/"
        }
    },
    "require": {
        "php": ">=8.4",
        "webkernel/lifecycle": "^0.12.0"
    },
    "extra": {
        "webkernel": {
            "package_repo": "git@github.com:webkernelphp/codebase.git",
            "production": true,
            "prefix": "codebase"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
