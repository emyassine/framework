{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "description": "Host app. workspaces globs = Composer install path (config.vendor-dir)/*/* + modules/*/* — kept in sync when vite.webapp.ts is generated.",
    "workspaces": [
        "third_party/webkernel/*",
        "modules/*/*"
    ],
    "scripts": {
        "dev": "vite",
        "build:vite": "vite build"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.1.1",
        "concurrently": "^9.0.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^7.0.2",
        "vite": "^8.0.0"
    }
}
