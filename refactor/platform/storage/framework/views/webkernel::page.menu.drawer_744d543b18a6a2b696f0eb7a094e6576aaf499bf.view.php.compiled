<?php  $__props = [
  'open' => true,
]; foreach ($__props as $__n => $__d) { if (!isset($$__n)) { $$__n = $__d; } } $attributes = (isset($attributes) && $attributes instanceof \Webkernel\View\AttributeBag ? $attributes : new \Webkernel\View\AttributeBag([]))->except(\array_keys($__props)); unset($__props, $__n, $__d); ?>
<?php 
  $attributes = $attributes ?? new \Webkernel\View\AttributeBag([]);
 ?>
<?php if ($this->once('wds.page.menu.drawer.view')): ?>
<style>
.wds-nav, .wds-drawer {
  color: var(--wds-nav-text);
  height: 100%;
  width: var(--wds-nav-width);
  flex: 0 0 var(--wds-nav-width);
  background: var(--wds-nav-bg);
  display: flex;
  flex-direction: column;
  font-size: 12.5px;
  line-height: 19px;
  font-weight: 400;
}
[data-wds-sidebar="collapsed"] .wds-nav,
[data-wds-sidebar="collapsed"] .wds-drawer { display: none; }
.wds-nav-brand, .wds-drawer-header {
  flex: 0 0 auto; height: 62px; padding: 0 20px;
  display: flex; align-items: center; gap: 0.75rem;
  box-shadow: color-mix(in srgb, currentColor 15%, transparent) 0 1px 0;
  color: inherit; overflow: hidden;
}
.wds-nav-brand-name, .wds-drawer-title {
  font-size: 16px; font-weight: 500; white-space: nowrap;
  overflow: hidden; text-overflow: ellipsis; color: inherit;
}
.wds-nav-scroll, .wds-drawer-body {
  flex: 1 1 100%; overflow-y: auto; overscroll-behavior: contain; padding: 1em;
}
.wds-nav-list { margin: 0; padding: 0; }
.wds-nav-search {
  margin: 0 0 2em; padding: 0.65em 1.3em; width: 100%;
  display: flex; align-items: center; color: inherit; font-weight: 500;
  border-radius: var(--wds-radius);
  background: color-mix(in srgb, currentColor 10%, transparent);
}
.wds-nav-search:hover { background: color-mix(in srgb, currentColor 16%, transparent); }
.wds-nav-group { margin: clamp(0.8em, 3vh, 4em) 0; }
.wds-nav-group:first-child { margin-top: 0; }
.wds-nav-link, .wds-nav-summary, .wds-menu-element {
  margin: 0; padding: 0.65em 1.3em; width: 100%;
  display: flex; align-items: center; color: inherit; font-weight: 500;
  border-radius: var(--wds-radius); text-align: start;
}
.wds-nav-summary { font-size: max(12px, 0.8em); cursor: pointer; list-style: none; }
.wds-nav-summary::-webkit-details-marker { display: none; }
.wds-nav-link:hover, .wds-nav-summary:hover, .wds-menu-element:hover {
  background: color-mix(in srgb, currentColor 10%, transparent);
}
.wds-nav-link.wds-active, .wds-nav-link[aria-current="page"], .wds-menu-element.wds-active {
  background: var(--primary-600); color: var(--color-white);
}
.wds-nav-icon {
  flex: 0 0 1.3em; text-align: center; margin-inline-end: 0.8em;
  display: inline-flex; align-items: center; justify-content: center;
}
.wds-nav-icon svg { opacity: 0.4; width: 1em; height: 1em; }
.wds-nav-link:hover .wds-nav-icon svg, .wds-nav-link.wds-active .wds-nav-icon svg { opacity: 1; }
.wds-nav-caret { margin-inline-start: auto; opacity: 0.75; }
details[open] > .wds-nav-summary .wds-nav-caret { transform: rotate(180deg); }
.wds-nav-sub .wds-nav-link { padding-inline-start: 2.6em; }
@media (max-width: 979px) {
  .wds-nav, .wds-drawer { display: none; }
  [data-wds-sidebar="expanded"] .wds-nav,
  [data-wds-sidebar="expanded"] .wds-drawer {
    display: flex; position: fixed; top: 0; bottom: 0;
    inset-inline-start: var(--wds-rail-width); z-index: 80;
  }
}
</style>
<?php endif; ?>
<nav <?php echo \Webkernel\View\View::echo($attributes->class('wds-nav wds-drawer')); ?> data-wds-drawer <?php if(! $open): ?> hidden <?php endif; ?>aria-label="<?php echo \Webkernel\View\View::echo(lang('panel.navigation')); ?>">
