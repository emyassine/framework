<?php 
  $current = \function_exists('i18n_current_lang') ? i18n_current_lang() : 'en';
  $codes = ['en', 'fr', 'ar', 'es', 'de', 'pt'];
  $back = \parse_url($_SERVER['REQUEST_URI'] ?? '/', PHP_URL_PATH) ?: '/';
 ?>
<div class="w-lang" data-w-lang>
  <button type="button" class="w-lang-trigger" onclick="this.parentElement.classList.toggle('w-open')" title="<?php echo \Webkernel\View\View::echo(lang('panel.language')); ?>">
    <span class="w-lang-flag"><?php echo flag_markup($current); ?></span>
    <span><?php echo \Webkernel\View\View::echo(\function_exists('i18n_catalog_language_label') ? i18n_catalog_language_label($current) : $current); ?></span>
  </button>
  <form class="w-lang-panel" method="post" action="/locale" role="menu">
    <?php echo \Webkernel\Csrf::field(); ?>

    <input type="hidden" name="_back" value="<?php echo \Webkernel\View\View::echo($back); ?>" />
    <?php foreach($codes as $code): ?>
      <button type="submit" name="locale" value="<?php echo \Webkernel\View\View::echo($code); ?>" class="<?php echo \Webkernel\View\View::echo($code === $current ? 'w-active' : ''); ?>" role="menuitem">
        <span class="w-lang-flag"><?php echo flag_markup($code); ?></span>
        <span><?php echo \Webkernel\View\View::echo(\function_exists('i18n_catalog_language_label') ? i18n_catalog_language_label($code) : $code); ?></span>
      </button>
    <?php endforeach; ?>
  </form>
</div>
