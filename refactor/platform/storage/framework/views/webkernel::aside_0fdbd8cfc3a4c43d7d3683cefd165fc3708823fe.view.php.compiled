<aside
  <?php echo \Webkernel\View\View::echo($attributes->class('wds-aside')); ?>

  data-position="<?php echo \Webkernel\View\View::echo($position); ?>"
  data-collapsed="<?php echo \Webkernel\View\View::echo($collapsed ? '1' : '0'); ?>"
>
  <?php echo $slot; ?>

</aside>
