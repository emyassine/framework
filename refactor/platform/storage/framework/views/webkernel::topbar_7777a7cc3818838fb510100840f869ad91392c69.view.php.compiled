
<?php  $__props = [
  'breadcrumbs' => [],
  'brand' => null,
]; foreach ($__props as $__n => $__d) { if (!isset($$__n)) { $$__n = $__d; } } $attributes = (isset($attributes) && $attributes instanceof \Webkernel\View\AttributeBag ? $attributes : new \Webkernel\View\AttributeBag([]))->except(\array_keys($__props)); unset($__props, $__n, $__d); ?>
<?php 
  $attributes = $attributes ?? new \Webkernel\View\AttributeBag([]);
  $breadcrumbs = \is_array($breadcrumbs) ? $breadcrumbs : [];
  $slot = $slot ?? '';
 ?>
<header <?php echo \Webkernel\View\View::echo($attributes->class('w-topbar')); ?>>
  <?php  $this->start_component('webkernel::button-icon',['icon'=>'menu','label'=>lang('panel.toggle_sidebar'),'size'=>'sm','color'=>'gray','onclick'=>'toggleSidebar()']); ?><?php echo $this->render_component(); ?>
  <?php  $this->start_component('webkernel::breadcrumbs',['breadcrumbs'=>$breadcrumbs]); ?><?php echo $this->render_component(); ?>
  <div class="w-topbar-end">
    <?php  $this->start_component('webkernel::language-selector',[]); ?><?php echo $this->render_component(); ?>
    <?php  $this->start_component('webkernel::button-icon',['icon'=>'sun','label'=>lang('panel.theme'),'size'=>'sm','color'=>'gray','id'=>'theme-btn','onclick'=>'toggleTheme()']); ?><?php echo $this->render_component(); ?>
    <?php echo $this->run_child('webkernel-system::system.user', ['brand' => $brand]); ?>
    <?php echo $slot; ?>

  </div>
</header>

