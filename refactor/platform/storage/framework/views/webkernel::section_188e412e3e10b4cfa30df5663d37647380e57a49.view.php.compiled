
<?php  $__props = [
  'heading' => null,
  'description' => null,
  'contained' => true,
]; foreach ($__props as $__n => $__d) { if (!isset($$__n)) { $$__n = $__d; } } $attributes = (isset($attributes) && $attributes instanceof \Webkernel\View\AttributeBag ? $attributes : new \Webkernel\View\AttributeBag([]))->except(\array_keys($__props)); unset($__props, $__n, $__d); ?>
<section class="wds-section">
  <?php if(($heading !== null && $heading !== '') || ($description !== null && $description !== '')): ?>
    <header class="wds-section-header">
      <?php if($heading !== null && $heading !== ''): ?>
        <h2 class="wds-section-heading"><?php echo \Webkernel\View\View::echo($heading); ?></h2>
      <?php endif; ?>
      <?php if($description !== null && $description !== ''): ?>
        <p class="wds-section-description"><?php echo \Webkernel\View\View::echo($description); ?></p>
      <?php endif; ?>
    </header>
  <?php endif; ?>
  <div class="wds-section-body">
    <?php echo $slot; ?>

  </div>
</section>
