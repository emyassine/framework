<style>
 /* ============================================================
 Webkernel Shell — SHELL LAYOUT SYSTEM
 Layouts:
 [data-webkernel-design-layout="sidebar"]   — classic sidebar + content
 [data-webkernel-design-layout="topnav"]    — full top navbar
 [data-webkernel-design-layout="horizontal"]— horizontal nav under top bar
 ============================================================ */

 /* --- Shell wrapper ---------------------------------------- */
 .webkernel-shell {
 display: flex;
 min-height: 100vh;
 position: relative;
 }

 /* ============================================================
 SIDEBAR LAYOUT
 ============================================================ */

 /* --- Sidebar ---------------------------------------------- */
 .webkernel-shell-sidebar {
 position: fixed;
 top: 0;
 left: 0;
 height: 100vh;
 width: var(--webkernel-shell-sidebar-width);
 background: var(--webkernel-design-surface);
 border-right: 1px solid var(--webkernel-design-border);
 display: flex;
 flex-direction: column;
 overflow: hidden;
 transition: width var(--webkernel-shell-transition);
 z-index: 50;
 }

 /* Collapsed state */
 [data-webkernel-design-sidebar="collapsed"] .webkernel-shell-sidebar {
 width: var(--webkernel-shell-sidebar-collapsed-width);
 }

 /* Sidebar inner scrollable zone */
 .webkernel-shell-sidebar__inner {
 flex: 1;
 overflow-y: auto;
 overflow-x: hidden;
 display: flex;
 flex-direction: column;
 padding: 0.75rem 0;
 scrollbar-width: none;
 }
 .webkernel-shell-sidebar__inner::-webkit-scrollbar { display: none; }

 /* Brand / logo row */
 .webkernel-shell-sidebar__brand {
 display: flex;
 align-items: center;
 gap: 0.625rem;
 padding: 0.75rem 1rem;
 height: var(--webkernel-shell-topbar-height);
 border-bottom: 1px solid var(--webkernel-design-border);
 overflow: hidden;
 flex-shrink: 0;
 }

 .webkernel-shell-brand-icon {
 width: 28px;
 height: 28px;
 border-radius: var(--webkernel-design-radius);
 background: var(--webkernel-design-accent);
 display: flex;
 align-items: center;
 justify-content: center;
 flex-shrink: 0;
 }
 .webkernel-shell-brand-icon svg { color: #fff; }

 .webkernel-shell-brand-name {
 font-size: var(--webkernel-design-font-size-base);
 font-weight: 600;
 letter-spacing: -0.01em;
 white-space: nowrap;
 opacity: 1;
 transition: opacity var(--webkernel-shell-transition);
 color: var(--webkernel-design-text);
 }

 [data-webkernel-design-sidebar="collapsed"] .webkernel-shell-brand-name,
 [data-webkernel-design-sidebar="collapsed"] .webkernel-shell-nav-label,
 [data-webkernel-design-sidebar="collapsed"] .webkernel-shell-nav-section-title,
 [data-webkernel-design-sidebar="collapsed"] .webkernel-shell-sidebar-footer__text {
 opacity: 0;
 pointer-events: none;
 width: 0;
 }

 /* Nav section label */
 .webkernel-shell-nav-section-title {
 font-size: var(--webkernel-design-font-size-xs);
 font-weight: 600;
 text-transform: uppercase;
 letter-spacing: 0.07em;
 color: var(--webkernel-design-text-faint);
 padding: 1rem 1rem 0.375rem;
 white-space: nowrap;
 overflow: hidden;
 transition: opacity var(--webkernel-shell-transition);
 }

 /* Nav group */
 .webkernel-shell-nav-group {
 display: flex;
 flex-direction: column;
 gap: 1px;
 padding: 0 0.5rem;
 }

 /* Nav item */
 .webkernel-shell-nav-item {
 display: flex;
 align-items: center;
 gap: 0.625rem;
 padding: 0.5rem 0.625rem;
 border-radius: var(--webkernel-design-radius);
 color: var(--webkernel-design-text-muted);
 font-size: var(--webkernel-design-font-size-sm);
 font-weight: 500;
 white-space: nowrap;
 transition: background var(--webkernel-shell-transition), color var(--webkernel-shell-transition);
 position: relative;
 cursor: pointer;
 }

 .webkernel-shell-nav-item:hover {
 background: var(--webkernel-design-bg-subtle);
 color: var(--webkernel-design-text);
 }

 .webkernel-shell-nav-item.active {
 background: var(--webkernel-design-accent-subtle);
 color: var(--webkernel-design-accent-text);
 }

 .webkernel-shell-nav-item .webkernel-shell-nav-icon {
 width: 16px;
 height: 16px;
 flex-shrink: 0;
 stroke: currentColor;
 fill: none;
 stroke-width: 2;
 stroke-linecap: round;
 stroke-linejoin: round;
 }

 .webkernel-shell-nav-label {
 transition: opacity var(--webkernel-shell-transition);
 white-space: nowrap;
 overflow: hidden;
 }

 /* Badge inside nav item */
 .webkernel-shell-nav-badge {
 margin-left: auto;
 background: var(--webkernel-design-accent);
 color: #fff;
 font-size: 0.625rem;
 font-weight: 700;
 padding: 1px 6px;
 border-radius: var(--webkernel-design-radius-full);
 line-height: 1.6;
 }

 /* Sidebar footer (user avatar row) */
 .webkernel-shell-sidebar-footer {
 border-top: 1px solid var(--webkernel-design-border);
 padding: 0.75rem 1rem;
 display: flex;
 align-items: center;
 gap: 0.625rem;
 overflow: hidden;
 flex-shrink: 0;
 }

 .webkernel-shell-avatar {
 width: 28px;
 height: 28px;
 border-radius: var(--webkernel-design-radius-full);
 background: var(--webkernel-color-primary-200);
 color: var(--webkernel-color-primary-800);
 font-size: 0.6875rem;
 font-weight: 700;
 display: flex;
 align-items: center;
 justify-content: center;
 flex-shrink: 0;
 }

 .webkernel-shell-sidebar-footer__text {
 display: flex;
 flex-direction: column;
 overflow: hidden;
 transition: opacity var(--webkernel-shell-transition);
 }
 .webkernel-shell-sidebar-footer__name {
 font-size: var(--webkernel-design-font-size-sm);
 font-weight: 600;
 white-space: nowrap;
 }
 .webkernel-shell-sidebar-footer__role {
 font-size: var(--webkernel-design-font-size-xs);
 color: var(--webkernel-design-text-muted);
 white-space: nowrap;
 }

 /* ============================================================
 MAIN CONTENT AREA
 ============================================================ */
 .webkernel-shell-main {
 flex: 1;
 display: flex;
 flex-direction: column;
 min-width: 0;
 margin-left: var(--webkernel-shell-sidebar-width);
 transition: margin-left var(--webkernel-shell-transition);
 }

 [data-webkernel-design-sidebar="collapsed"] .webkernel-shell-main {
 margin-left: var(--webkernel-shell-sidebar-collapsed-width);
 }

 /* Full topnav layout: no sidebar offset */
 [data-webkernel-design-layout="topnav"] .webkernel-shell-main,
 [data-webkernel-design-layout="horizontal"] .webkernel-shell-main {
 margin-left: 0;
 }

 /* ============================================================
 TOP NAVBAR
 ============================================================ */
 .webkernel-shell-topbar {
 height: var(--webkernel-shell-topbar-height);
 border-bottom: 1px solid var(--webkernel-design-border);
 display: flex;
 align-items: center;
 padding: 0 1.25rem;
 gap: 0.75rem;
 background: var(--webkernel-design-surface);
 position: sticky;
 top: 0;
 z-index: 40;
 }

 /* Toggle sidebar button */
 .webkernel-shell-sidebar-toggle {
 width: 32px;
 height: 32px;
 display: flex;
 align-items: center;
 justify-content: center;
 border-radius: var(--webkernel-design-radius);
 color: var(--webkernel-design-text-muted);
 transition: background var(--webkernel-shell-transition), color var(--webkernel-shell-transition);
 flex-shrink: 0;
 }
 .webkernel-shell-sidebar-toggle:hover {
 background: var(--webkernel-design-bg-subtle);
 color: var(--webkernel-design-text);
 }
 .webkernel-shell-sidebar-toggle svg {
 width: 16px;
 height: 16px;
 stroke: currentColor;
 fill: none;
 stroke-width: 2;
 stroke-linecap: round;
 }

 /* Breadcrumb */
 .webkernel-shell-breadcrumb {
 display: flex;
 align-items: center;
 gap: 0.375rem;
 font-size: var(--webkernel-design-font-size-sm);
 color: var(--webkernel-design-text-muted);
 }
 .webkernel-shell-breadcrumb__sep {
 color: var(--webkernel-design-border-strong);
 font-size: 0.75rem;
 }
 .webkernel-shell-breadcrumb__current {
 color: var(--webkernel-design-text);
 font-weight: 500;
 }

 /* Topbar right slot */
 .webkernel-shell-topbar-right {
 margin-left: auto;
 display: flex;
 align-items: center;
 gap: 0.5rem;
 }

 /* Icon button */
 .webkernel-shell-icon-btn {
 width: 32px;
 height: 32px;
 display: flex;
 align-items: center;
 justify-content: center;
 border-radius: var(--webkernel-design-radius);
 border: 1px solid var(--webkernel-design-border);
 color: var(--webkernel-design-text-muted);
 background: var(--webkernel-design-surface);
 transition: background var(--webkernel-shell-transition), color var(--webkernel-shell-transition), border-color var(--webkernel-shell-transition);
 }
 .webkernel-shell-icon-btn:hover {
 background: var(--webkernel-design-bg-subtle);
 color: var(--webkernel-design-text);
 border-color: var(--webkernel-design-border-strong);
 }
 .webkernel-shell-icon-btn svg {
 width: 15px;
 height: 15px;
 stroke: currentColor;
 fill: none;
 stroke-width: 2;
 stroke-linecap: round;
 stroke-linejoin: round;
 }

 /* Layout switcher pill */
 .webkernel-shell-layout-switcher {
 display: flex;
 align-items: center;
 background: var(--webkernel-design-bg-subtle);
 border: 1px solid var(--webkernel-design-border);
 border-radius: var(--webkernel-design-radius);
 padding: 2px;
 gap: 2px;
 }
 .webkernel-shell-layout-btn {
 padding: 0.25rem 0.625rem;
 font-size: var(--webkernel-design-font-size-xs);
 font-weight: 500;
 border-radius: calc(var(--webkernel-design-radius) - 2px);
 color: var(--webkernel-design-text-muted);
 transition: background var(--webkernel-shell-transition), color var(--webkernel-shell-transition);
 white-space: nowrap;
 }
 .webkernel-shell-layout-btn:hover {
 color: var(--webkernel-design-text);
 }
 .webkernel-shell-layout-btn.active {
 background: var(--webkernel-design-surface);
 color: var(--webkernel-design-text);
 box-shadow: var(--webkernel-design-shadow-sm);
 }

 /* ============================================================
 HORIZONTAL NAV BAR (sub-topbar for "horizontal" layout)
 ============================================================ */
 .webkernel-shell-horiz-nav {
 display: none;
 align-items: center;
 gap: 0.25rem;
 height: 42px;
 padding: 0 1.25rem;
 border-bottom: 1px solid var(--webkernel-design-border);
 background: var(--webkernel-design-surface);
 }

 [data-webkernel-design-layout="horizontal"] .webkernel-shell-horiz-nav {
 display: flex;
 }

 .webkernel-shell-horiz-nav-item {
 display: flex;
 align-items: center;
 gap: 0.375rem;
 padding: 0.3125rem 0.75rem;
 font-size: var(--webkernel-design-font-size-sm);
 font-weight: 500;
 color: var(--webkernel-design-text-muted);
 border-radius: var(--webkernel-design-radius);
 cursor: pointer;
 transition: background var(--webkernel-shell-transition), color var(--webkernel-shell-transition);
 }
 .webkernel-shell-horiz-nav-item svg {
 width: 14px;
 height: 14px;
 stroke: currentColor;
 fill: none;
 stroke-width: 2;
 stroke-linecap: round;
 stroke-linejoin: round;
 }
 .webkernel-shell-horiz-nav-item:hover {
 background: var(--webkernel-design-bg-subtle);
 color: var(--webkernel-design-text);
 }
 .webkernel-shell-horiz-nav-item.active {
 background: var(--webkernel-design-accent-subtle);
 color: var(--webkernel-design-accent-text);
 }

 /* ============================================================
 FULL TOPNAV LAYOUT: sidebar hidden, top brand bar visible
 ============================================================ */
 [data-webkernel-design-layout="sidebar"] .webkernel-shell-sidebar {
 display: flex;
 }

 [data-webkernel-design-layout="topnav"] .webkernel-shell-sidebar,
 [data-webkernel-design-layout="horizontal"] .webkernel-shell-sidebar {
 display: none;
 }

 .webkernel-shell-topbar-brand {
 display: none;
 align-items: center;
 gap: 0.5rem;
 margin-right: 1rem;
 }

 [data-webkernel-design-layout="topnav"] .webkernel-shell-topbar-brand,
 [data-webkernel-design-layout="horizontal"] .webkernel-shell-topbar-brand {
 display: flex;
 }

 .webkernel-shell-topbar-nav {
 display: none;
 align-items: center;
 gap: 0.25rem;
 }

 [data-webkernel-design-layout="topnav"] .webkernel-shell-topbar-nav {
 display: flex;
 }

 .webkernel-shell-topnav-item {
 display: flex;
 align-items: center;
 gap: 0.375rem;
 padding: 0.3125rem 0.75rem;
 font-size: var(--webkernel-design-font-size-sm);
 font-weight: 500;
 color: var(--webkernel-design-text-muted);
 border-radius: var(--webkernel-design-radius);
 cursor: pointer;
 transition: background var(--webkernel-shell-transition), color var(--webkernel-shell-transition);
 }
 .webkernel-shell-topnav-item:hover {
 background: var(--webkernel-design-bg-subtle);
 color: var(--webkernel-design-text);
 }
 .webkernel-shell-topnav-item.active {
 background: var(--webkernel-design-accent-subtle);
 color: var(--webkernel-design-accent-text);
 }

 /* Toggle sidebar icon: hidden in topnav / horizontal modes */
 [data-webkernel-design-layout="topnav"] .webkernel-shell-sidebar-toggle,
 [data-webkernel-design-layout="horizontal"] .webkernel-shell-sidebar-toggle {
 display: none;
 }

 [data-webkernel-design-layout="topnav"] .webkernel-shell-breadcrumb,
 [data-webkernel-design-layout="horizontal"] .webkernel-shell-breadcrumb {
 display: none;
 }

 /* ============================================================
 PAGE CONTENT WRAPPER
 ============================================================ */
 .webkernel-shell-content {
 flex: 1;
 padding: 1.75rem 2rem;
 max-width: 1280px;
 width: 100%;
 margin: 0 auto;
 display: flex;
 flex-direction: column;
 gap: 1.75rem;
 }

 .webkernel-shell-icon,
 .webkernel-shell-icon__svg,
 .webkernel-shell-nav-icon svg,
 .webkernel-shell-icon svg {
 width: 16px;
 height: 16px;
 display: block;
 flex-shrink: 0;
 }

 .webkernel-shell-user-menu {
 position: relative;
 width: 100%;
 }
 .webkernel-shell-user-menu__trigger {
 width: 100%;
 display: flex;
 align-items: center;
 gap: 0.625rem;
 background: transparent;
 border: 0;
 padding: 0;
 color: inherit;
 cursor: pointer;
 text-align: left;
 }
 .webkernel-shell-user-menu__chevron {
 margin-left: auto;
 width: 14px;
 height: 14px;
 color: var(--webkernel-design-text-muted);
 }
 .webkernel-shell-user-menu__panel {
 display: none;
 position: absolute;
 left: 0.5rem;
 right: 0.5rem;
 bottom: calc(100% + 0.5rem);
 background: var(--webkernel-design-surface);
 border: 1px solid var(--webkernel-design-border);
 border-radius: var(--webkernel-design-radius-lg);
 box-shadow: var(--webkernel-design-shadow-md);
 padding: 0.35rem;
 z-index: 60;
 }
 .webkernel-shell-user-menu.is-open .webkernel-shell-user-menu__panel {
 display: flex;
 flex-direction: column;
 }
 .webkernel-shell-user-menu__panel a {
 display: flex;
 align-items: center;
 gap: 0.5rem;
 padding: 0.5rem 0.625rem;
 border-radius: var(--webkernel-design-radius);
 color: var(--webkernel-design-text-muted);
 font-size: var(--webkernel-design-font-size-sm);
 font-weight: 500;
 }
 .webkernel-shell-user-menu__panel a:hover {
 background: var(--webkernel-design-bg-subtle);
 color: var(--webkernel-design-text);
 }


 .webkernel-shell-brand-mark {
 width: 28px;
 height: 28px;
 object-fit: contain;
 flex-shrink: 0;
 border-radius: var(--webkernel-design-radius);
 }
 .webkernel-shell-topbar-brand .webkernel-shell-brand-mark {
 width: 24px;
 height: 24px;
 }
</style>
