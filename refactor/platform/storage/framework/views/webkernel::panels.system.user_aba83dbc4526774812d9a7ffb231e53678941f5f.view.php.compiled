<div class="wds-user-menu" id="wds-user-menu">
  <button type="button" class="wds-user-menu-trigger" onclick="toggleUserMenu()" aria-haspopup="menu" aria-expanded="false">
    <span class="wds-avatar"><?php echo \Webkernel\View\View::echo(strtoupper(substr((string) ($brand ?? 'W'), 0, 1))); ?></span>
    <span class="wds-sidebar-footer-text">
      <span class="wds-sidebar-footer-name"><?php echo \Webkernel\View\View::echo($brand ?? 'Webkernel'); ?></span>
      <span class="wds-sidebar-footer-role">Signed in</span>
    </span>
    <span class="wds-user-menu-chevron">
      <?php  $this->start_component('webkernel::icon',['name'=>'chevron-up']); ?><?php echo $this->render_component(); ?>
    </span>
  </button>
  <div class="wds-user-menu-panel" role="menu">
    <a href="/system" role="menuitem">
      <?php  $this->start_component('webkernel::icon',['name'=>'circle-user']); ?><?php echo $this->render_component(); ?>
      Profile
    </a>
    <a href="/system" role="menuitem">
      <?php  $this->start_component('webkernel::icon',['name'=>'settings']); ?><?php echo $this->render_component(); ?>
      Settings
    </a>
    <a href="/" role="menuitem">
      <?php  $this->start_component('webkernel::icon',['name'=>'log-out']); ?><?php echo $this->render_component(); ?>
      Sign out
    </a>
  </div>
</div>
