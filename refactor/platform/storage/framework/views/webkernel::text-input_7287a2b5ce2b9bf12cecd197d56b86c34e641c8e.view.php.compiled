
<?php  $__props = [
  'name' => '',
  'label' => null,
  'value' => '',
  'type' => 'text',
  'mode' => 'editable',
  'hint' => null,
  'error' => null,
]; foreach ($__props as $__n => $__d) { if (!isset($$__n)) { $$__n = $__d; } } $attributes = (isset($attributes) && $attributes instanceof \Webkernel\View\AttributeBag ? $attributes : new \Webkernel\View\AttributeBag([]))->except(\array_keys($__props)); unset($__props, $__n, $__d); ?>
<?php if($mode === 'readonly'): ?>
  <div class="w-fo-field w-readonly">
    <dt><?php echo \Webkernel\View\View::echo($label ?? $name); ?></dt>
    <dd><?php echo \Webkernel\View\View::echo($value); ?></dd>
  </div>
<?php else: ?>
  <p class="w-fo-field<?php echo \Webkernel\View\View::echo($error ? ' w-invalid' : ''); ?>">
    <label>
      <?php echo \Webkernel\View\View::echo($label ?? $name); ?>

      <span class="w-input-wrp">
        <span class="w-input-wrp-content">
          <?php if($type === 'textarea'): ?>
            <textarea class="w-input" name="<?php echo \Webkernel\View\View::echo($name); ?>" rows="5"><?php echo \Webkernel\View\View::echo($value); ?></textarea>
          <?php else: ?>
            <input class="w-input" type="<?php echo \Webkernel\View\View::echo($type); ?>" name="<?php echo \Webkernel\View\View::echo($name); ?>" value="<?php echo \Webkernel\View\View::echo($value); ?>" />
          <?php endif; ?>
        </span>
      </span>
    </label>
    <?php if($error): ?>
      <span class="w-field-error"><?php echo \Webkernel\View\View::echo($error); ?></span>
    <?php elseif($hint): ?>
      <span class="w-form-hint"><?php echo \Webkernel\View\View::echo($hint); ?></span>
    <?php endif; ?>
  </p>
<?php endif; ?>
