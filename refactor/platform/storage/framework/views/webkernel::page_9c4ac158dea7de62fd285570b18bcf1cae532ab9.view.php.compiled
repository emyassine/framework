
<?php  $__props = [
  'title' => null,
  'description' => null,
]; foreach ($__props as $__n => $__d) { if (!isset($$__n)) { $$__n = $__d; } } $attributes = (isset($attributes) && $attributes instanceof \Webkernel\View\AttributeBag ? $attributes : new \Webkernel\View\AttributeBag([]))->except(\array_keys($__props)); unset($__props, $__n, $__d); ?>
<div class="webkernel-shell-page">
  <header class="webkernel-shell-page-header">
    <div>
      <?php if($title !== null && $title !== ''): ?>
        <h1 class="webkernel-shell-page-title"><?php echo \Webkernel\View\View::echo($title); ?></h1>
      <?php endif; ?>
      <?php if($description !== null && $description !== ''): ?>
        <p class="webkernel-shell-page-desc"><?php echo \Webkernel\View\View::echo($description); ?></p>
      <?php endif; ?>
    </div>
    <?php if(!empty($actions)): ?>
      <div class="webkernel-shell-page-actions">
        <?php echo $actions; ?>

      </div>
    <?php endif; ?>
  </header>
  <div class="webkernel-shell-page-body">
    <?php echo $slot; ?>

  </div>
</div>
