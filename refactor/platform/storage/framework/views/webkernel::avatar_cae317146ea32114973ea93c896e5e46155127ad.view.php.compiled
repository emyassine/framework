<?php  $__props = [
  'alt' => '',
  'src' => null,
  'circular' => true,
  'size' => 'md',
]; foreach ($__props as $__n => $__d) { if (!isset($$__n)) { $$__n = $__d; } } $attributes = (isset($attributes) && $attributes instanceof \Webkernel\View\AttributeBag ? $attributes : new \Webkernel\View\AttributeBag([]))->except(\array_keys($__props)); unset($__props, $__n, $__d); ?>
<?php 
  $size = \in_array((string) $size, ['sm', 'md', 'lg'], true) ? (string) $size : 'md';
 ?>
<?php if(!empty($src)): ?>
  <img
    class="wds-avatar<?php echo \Webkernel\View\View::echo($circular ? ' wds-circular' : ''); ?> wds-size-<?php echo \Webkernel\View\View::echo($size); ?>"
    src="<?php echo \Webkernel\View\View::echo($src); ?>"
    alt="<?php echo \Webkernel\View\View::echo($alt); ?>"
  />
<?php else: ?>
  <span class="wds-avatar<?php echo \Webkernel\View\View::echo($circular ? ' wds-circular' : ''); ?> wds-size-<?php echo \Webkernel\View\View::echo($size); ?>"><?php echo \Webkernel\View\View::echo(strtoupper(substr((string) ($alt !== '' ? $alt : 'W'), 0, 1))); ?></span>
<?php endif; ?>
