<?php  $__props = [
  'active' => false,
  'disabled' => false,
  'label' => null,
  'icon' => null,
]; foreach ($__props as $__n => $__d) { if (!isset($$__n)) { $$__n = $__d; } } $attributes = (isset($attributes) && $attributes instanceof \Webkernel\View\AttributeBag ? $attributes : new \Webkernel\View\AttributeBag([]))->except(\array_keys($__props)); unset($__props, $__n, $__d); ?>
<?php 
  $attributes = $attributes ?? new \Webkernel\View\AttributeBag([]);
 ?>
<?php if ($this->once('wds.pagination.item')): ?>
<style>
.wds-pagination-item-btn:disabled { pointer-events: none; }
</style>
<?php endif; ?>
<li <?php echo \Webkernel\View\View::echo($attributes->class([
  'wds-pagination-item',
  'wds-disabled' => $disabled,
  'wds-active' => $active,
])); ?>>
  <button
    type="button"
    class="wds-pagination-item-btn"
    <?php if($active): ?> aria-current="page" <?php endif; ?>
    <?php if($disabled): ?> disabled aria-hidden="true" <?php endif; ?>
  >
    <?php if($icon): ?>
      <?php  $this->start_component('webkernel::icon',['name'=>$icon]); ?><?php echo $this->render_component(); ?>
    <?php endif; ?>
    <?php if($label !== null && $label !== ''): ?>
      <span class="wds-pagination-item-label"><?php echo \Webkernel\View\View::echo($label); ?></span>
    <?php endif; ?>
  </button>
</li>
