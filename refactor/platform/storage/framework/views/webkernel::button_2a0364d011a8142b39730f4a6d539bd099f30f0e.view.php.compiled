
<?php  $__props = [
  'badge' => null,
  'badge_color' => 'primary',
  'color' => 'primary',
  'disabled' => false,
  'form' => null,
  'href' => null,
  'icon' => null,
  'icon_position' => 'before',
  'outlined' => false,
  'size' => 'md',
  'tag' => 'button',
  'target' => null,
  'tooltip' => null,
  'type' => 'button',
]; foreach ($__props as $__n => $__d) { if (!isset($$__n)) { $$__n = $__d; } } $attributes = (isset($attributes) && $attributes instanceof \Webkernel\View\AttributeBag ? $attributes : new \Webkernel\View\AttributeBag([]))->except(\array_keys($__props)); unset($__props, $__n, $__d); ?>
<?php 
  $tag = $tag === 'a' || ($href !== null && $href !== '') ? 'a' : 'button';
  $size = $size instanceof \Webkernel\Platform\Components\Size ? $size->value : (string) $size;
  $icon_position = $icon_position instanceof \Webkernel\Platform\Components\IconPosition
      ? $icon_position->value
      : (string) $icon_position;
  $attributes = $attributes ?? new \Webkernel\View\AttributeBag([]);
 ?>
<<?php echo \Webkernel\View\View::echo($tag); ?>

  <?php if($tag === 'a' && $href && ! $disabled): ?>
    href="<?php echo \Webkernel\View\View::echo($href); ?>"
    <?php if($target): ?>
      target="<?php echo \Webkernel\View\View::echo($target); ?>"
      <?php if($target === '_blank'): ?> rel="noopener noreferrer" <?php endif; ?>
    <?php endif; ?>
  <?php endif; ?>
  <?php if($tag === 'button'): ?>
    type="<?php echo \Webkernel\View\View::echo($type); ?>"
    <?php if($form): ?> form="<?php echo \Webkernel\View\View::echo($form); ?>" <?php endif; ?>
    <?php if($disabled): ?> disabled <?php endif; ?>
  <?php endif; ?>
  <?php if($disabled): ?> aria-disabled="true" <?php endif; ?>
  <?php if($tooltip): ?> title="<?php echo \Webkernel\View\View::echo($tooltip); ?>" <?php endif; ?>
  <?php echo \Webkernel\View\View::echo($attributes->class([
    'w-btn',
    'w-color-'.$color,
    'w-size-'.$size,
    'w-outlined' => $outlined,
    'w-disabled' => $disabled,
  ])); ?>

>
  <?php if($icon && $icon_position !== 'after'): ?>
    <?php  $this->start_component('webkernel::icon',['name'=>$icon]); ?><?php echo $this->render_component(); ?>
  <?php endif; ?>
  <?php if($slot !== ''): ?>
    <span class="w-btn-label"><?php echo $slot; ?></span>
  <?php endif; ?>
  <?php if($icon && $icon_position === 'after'): ?>
    <?php  $this->start_component('webkernel::icon',['name'=>$icon]); ?><?php echo $this->render_component(); ?>
  <?php endif; ?>
  <?php if($badge !== null && $badge !== ''): ?>
    <span class="w-btn-badge w-badge w-color-<?php echo \Webkernel\View\View::echo($badge_color); ?>"><?php echo $badge; ?></span>
  <?php endif; ?>
</<?php echo \Webkernel\View\View::echo($tag); ?>>
