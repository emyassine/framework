
<?php  $__props = [
  'label' => null,
  'contained' => true,
  'label_hidden' => false,
  'required' => false,
]; foreach ($__props as $__n => $__d) { if (!isset($$__n)) { $$__n = $__d; } } $attributes = (isset($attributes) && $attributes instanceof \Webkernel\View\AttributeBag ? $attributes : new \Webkernel\View\AttributeBag([]))->except(\array_keys($__props)); unset($__props, $__n, $__d); ?>
<?php 
  $attributes = $attributes ?? new \Webkernel\View\AttributeBag([]);
 ?>
<fieldset <?php echo \Webkernel\View\View::echo($attributes->class([
  'w-fieldset',
  'w-fieldset-label-hidden' => $label_hidden,
  'w-fieldset-not-contained' => ! $contained,
])); ?>>
  <?php if($label !== null && $label !== ''): ?>
    <legend>
      <?php echo \Webkernel\View\View::echo($label); ?><?php if($required): ?><sup class="w-fieldset-label-required">*</sup><?php endif; ?>
    </legend>
  <?php endif; ?>
  <?php echo $slot; ?>

</fieldset>
