
<?php  $__props = [
  'name' => '',
  'label' => null,
  'value' => '',
  'rows' => 2,
  'cols' => null,
  'autosize' => false,
  'placeholder' => null,
  'disabled' => false,
  'mode' => 'editable',
  'hint' => null,
  'error' => null,
]; foreach ($__props as $__n => $__d) { if (!isset($$__n)) { $$__n = $__d; } } $attributes = (isset($attributes) && $attributes instanceof \Webkernel\View\AttributeBag ? $attributes : new \Webkernel\View\AttributeBag([]))->except(\array_keys($__props)); unset($__props, $__n, $__d); ?>
<?php 
  $attributes = $attributes ?? new \Webkernel\View\AttributeBag([]);
  $rows = \is_numeric($rows) ? (int) $rows : 2;
  if ($rows < 1) {
    $rows = 2;
  }
 ?>
<?php if($mode === 'readonly'): ?>
  <div <?php echo \Webkernel\View\View::echo($attributes->class(['w-fo-field', 'w-readonly'])); ?>>
    <dt><?php echo \Webkernel\View\View::echo($label ?? $name); ?></dt>
    <dd><?php echo \Webkernel\View\View::echo($value); ?></dd>
  </div>
<?php else: ?>
  <p <?php echo \Webkernel\View\View::echo($attributes->class(['w-fo-field', 'w-fo-textarea-wrp', 'w-invalid' => $error])); ?>>
    <label>
      <?php echo \Webkernel\View\View::echo($label ?? $name); ?>

      <span class="w-input-wrp<?php echo \Webkernel\View\View::echo($disabled ? ' w-disabled' : ''); ?><?php echo \Webkernel\View\View::echo($error ? ' w-invalid' : ''); ?>">
        <span class="w-input-wrp-content">
          <span class="w-fo-textarea<?php echo \Webkernel\View\View::echo($autosize ? ' w-autosizable' : ''); ?>" style="--w-rows: <?php echo \Webkernel\View\View::echo($rows); ?>" data-w-textarea>
            <textarea
              class="w-input"
              name="<?php echo \Webkernel\View\View::echo($name); ?>"
              rows="<?php echo \Webkernel\View\View::echo($rows); ?>"
              <?php if($cols): ?> cols="<?php echo \Webkernel\View\View::echo($cols); ?>" <?php endif; ?>
              <?php if($placeholder !== null): ?> placeholder="<?php echo \Webkernel\View\View::echo($placeholder); ?>" <?php endif; ?>
              <?php if($disabled): ?> disabled <?php endif; ?>
              <?php if($autosize): ?> data-autosize="true" <?php endif; ?>
            ><?php echo \Webkernel\View\View::echo($value); ?></textarea>
          </span>
        </span>
      </span>
    </label>
    <?php if($error): ?>
      <span class="w-field-error"><?php echo \Webkernel\View\View::echo($error); ?></span>
    <?php elseif($hint): ?>
      <span class="w-form-hint"><?php echo \Webkernel\View\View::echo($hint); ?></span>
    <?php endif; ?>
  </p>
<?php endif; ?>
