
<style>
    .wds-layout {
      display: flex;
      min-height: 100vh;
      position: relative;
    }

    .wds-sidebar {
      position: sticky;
      top: 0;
      align-self: start;
      height: 100vh;
      width: var(--wds-sidebar-width);
      flex: 0 0 var(--wds-sidebar-width);
      background: var(--wds-app-rail-bg);
      overflow: hidden;
      z-index: 50;
    }

    [data-wds-sidebar="collapsed"] .wds-sidebar {
      width: var(--wds-sidebar-width-collapsed);
      flex-basis: var(--wds-sidebar-width-collapsed);
    }

    .wds-app-list {
      list-style: none;
      height: 100vh;
      overflow: auto;
      overscroll-behavior: contain;
      position: relative;
    }

    .wds-app-logo {
      height: 62px;
      display: flex;
      align-items: center;
      justify-content: center;
      width: var(--wds-app-rail-width);
    }
    .wds-app-logo img,
    .wds-app-logo .wds-logo-img {
      width: 30px;
      height: 30px;
      object-fit: contain;
    }
    .wds-logo-icon {
      width: 30px;
      height: 30px;
      border-radius: var(--wds-radius);
      background: var(--primary-600);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
    }

    .wds-app-item {
      width: var(--wds-app-rail-width);
    }
    .wds-app-item > a.wds-app-icon {
      display: flex;
      justify-content: center;
      align-items: center;
      height: var(--wds-app-rail-width);
      color: rgba(255, 255, 255, 0.7);
      position: relative;
    }
    .wds-app-item > a.wds-app-icon:hover,
    .wds-app-item.wds-active > a.wds-app-icon {
      color: #fff;
      background: rgba(255, 255, 255, 0.05);
    }
    .wds-app-item > a.wds-app-icon .wds-icon,
    .wds-app-item > a.wds-app-icon svg {
      width: 20px;
      height: 20px;
      stroke: currentColor;
      fill: none;
      stroke-width: 1.75;
    }
    .wds-app-item-label {
      display: none;
    }

    .wds-app-submenu {
      display: none;
      position: absolute;
      top: 0;
      bottom: 0;
      inset-inline-start: var(--wds-app-rail-width);
      width: var(--wds-app-menu-width);
      background: var(--wds-surface);
      border-inline-end: 1px solid var(--wds-border);
      color: var(--wds-text-muted);
      z-index: 3;
      overflow: auto;
      overscroll-behavior: contain;
    }
    .wds-app-item.wds-active .wds-app-submenu {
      display: block;
    }
    .wds-app-item:hover .wds-app-submenu {
      display: block;
      z-index: 4;
    }
    [data-wds-sidebar="collapsed"] .wds-app-submenu {
      display: none !important;
    }

    .wds-app-menu-header {
      color: var(--wds-text);
      font-size: 17px;
      font-weight: 600;
      line-height: 61px;
      padding-inline-start: 1.5em;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      margin: 0;
    }

    .wds-sidebar-nav {
      padding: 0 1em 1em;
    }
    .wds-sidebar-group {
      margin-bottom: 1em;
    }
    .wds-sidebar-group-label {
      color: var(--wds-text);
      padding: 1em 1em 0;
      text-transform: uppercase;
      font-weight: 700;
      font-size: var(--wds-text-xs);
      letter-spacing: 0.04em;
      background: var(--wds-surface);
      position: sticky;
      top: 0;
      z-index: 1;
    }
    .wds-sidebar-item {
      color: var(--wds-text-muted);
      display: block;
      padding: 0.25em 1em;
      border-radius: 5px;
      font-size: var(--wds-text-sm);
    }
    .wds-sidebar-item:hover {
      color: var(--wds-text);
      background: var(--wds-bg-subtle);
    }
    .wds-sidebar-item.wds-active {
      color: var(--wds-text);
      background: var(--wds-bg-subtle);
      font-weight: 600;
    }
    [data-wds-theme="dark"] .wds-sidebar-item:hover {
      background: var(--gray-800);
    }
    [data-wds-theme="dark"] .wds-sidebar-item.wds-active {
      background: var(--gray-800);
    }
    .wds-sidebar-item .wds-icon,
    .wds-sidebar-item-label {
      display: none;
    }

    .wds-app-reorder {
      position: fixed;
      bottom: 0;
      z-index: 50;
      width: var(--wds-app-rail-width);
      display: grid;
      place-content: center;
      color: #fff;
      opacity: 0.75;
      padding: 1em 0;
    }
    .wds-app-reorder:hover,
    .wds-app-reorder.wds-active {
      opacity: 1;
      color: #fff;
    }
    .wds-app-item[draggable="true"] {
      cursor: grab;
    }

    .wds-main-ctn {
      flex: 1 1 100%;
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    .wds-topbar {
      height: var(--wds-topbar-height);
      box-sizing: content-box;
      display: flex;
      align-items: center;
      padding: 0 10px;
      gap: 0.75rem;
      background: var(--wds-surface);
      color: var(--wds-text);
      position: sticky;
      top: 0;
      z-index: 40;
      box-shadow: hsl(0 0% 0% / 0.1) 0 1px 0 0;
    }

    .wds-sidebar-open-btn {
      width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: var(--wds-radius);
      color: var(--wds-text-muted);
      flex-shrink: 0;
    }
    .wds-sidebar-open-btn:hover {
      background: var(--wds-bg-subtle);
      color: var(--wds-text);
    }
    .wds-sidebar-open-btn svg {
      width: 16px;
      height: 16px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
    }

    .wds-search {
      flex: 1 1 100%;
      display: flex;
      align-items: center;
      height: 41px;
      background: var(--wds-bg-subtle);
      color: var(--wds-text);
      border-radius: 6px;
      margin-inline-end: 10px;
    }
    .wds-search:focus-within {
      background: var(--wds-surface);
      outline: 2px solid var(--primary-600);
      outline-offset: -1px;
    }
    .wds-search .wds-icon,
    .wds-search svg {
      margin: 0 1em;
      opacity: 0.6;
      width: 14px;
      height: 14px;
    }
    .wds-search input {
      border: 0;
      background: transparent;
      max-width: 100%;
      padding: 0.75em 0;
      color: inherit;
      box-shadow: none;
      flex: 1 1 100%;
      outline: none;
      font: inherit;
    }
    .wds-search input::placeholder {
      color: var(--wds-text-muted);
      opacity: 1;
    }

    .wds-breadcrumbs {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      font-size: 12px;
      color: var(--wds-text-muted);
      margin-bottom: 10px;
    }
    .wds-breadcrumbs-sep {
      color: var(--wds-border-strong);
      font-size: 0.75rem;
    }
    .wds-breadcrumbs-current {
      color: var(--wds-text);
      font-weight: 500;
    }

    .wds-topbar-end {
      margin-inline-start: auto;
      display: flex;
      align-items: center;
      gap: 0.25rem;
      flex: 0 0 auto;
      font-size: 13px;
      font-weight: 600;
    }

    .wds-icon-btn {
      min-width: 40px;
      min-height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 4px;
      color: var(--wds-text-muted);
      padding: 0 15px;
      gap: 0.5em;
    }
    .wds-icon-btn:hover {
      background: var(--wds-bg-subtle);
      color: var(--wds-text);
    }
    .wds-icon-btn svg {
      width: 15px;
      height: 15px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .wds-layout-switcher {
      display: flex;
      align-items: center;
      background: var(--wds-bg-subtle);
      border: 1px solid var(--wds-border);
      border-radius: var(--wds-radius);
      padding: 2px;
      gap: 2px;
    }
    .wds-layout-switcher-btn {
      padding: 0.25rem 0.625rem;
      font-size: var(--wds-text-xs);
      font-weight: 500;
      border-radius: calc(var(--wds-radius) - 2px);
      color: var(--wds-text-muted);
      white-space: nowrap;
    }
    .wds-layout-switcher-btn:hover {
      color: var(--wds-text);
    }
    .wds-layout-switcher-btn.wds-active {
      background: var(--wds-surface);
      color: var(--wds-text);
      box-shadow: var(--wds-shadow-sm);
    }

    .wds-horizontal-nav {
      display: none;
      align-items: center;
      gap: 0.25rem;
      height: 42px;
      padding: 0 1.25rem;
      border-bottom: 1px solid var(--wds-border);
      background: var(--wds-surface);
    }
    [data-wds-layout="horizontal"] .wds-horizontal-nav {
      display: flex;
    }
    .wds-horizontal-nav-item {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.3125rem 0.75rem;
      font-size: var(--wds-text-sm);
      font-weight: 500;
      color: var(--wds-text-muted);
      border-radius: var(--wds-radius);
    }
    .wds-horizontal-nav-item:hover {
      background: var(--wds-bg-subtle);
      color: var(--wds-text);
    }
    .wds-horizontal-nav-item.wds-active {
      background: var(--primary-50);
      color: var(--primary-700);
    }

    [data-wds-layout="topnav"] .wds-sidebar,
    [data-wds-layout="horizontal"] .wds-sidebar {
      display: none;
    }
    .wds-topbar-logo {
      display: none;
      align-items: center;
      gap: 0.5rem;
      margin-inline-end: 1rem;
    }
    [data-wds-layout="topnav"] .wds-topbar-logo,
    [data-wds-layout="horizontal"] .wds-topbar-logo {
      display: flex;
    }
    .wds-topbar-nav {
      display: none;
      align-items: center;
      gap: 0.25rem;
    }
    [data-wds-layout="topnav"] .wds-topbar-nav {
      display: flex;
    }
    .wds-topbar-item {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.3125rem 0.75rem;
      font-size: var(--wds-text-sm);
      font-weight: 500;
      color: var(--wds-text-muted);
      border-radius: var(--wds-radius);
    }
    .wds-topbar-item:hover {
      background: var(--wds-bg-subtle);
      color: var(--wds-text);
    }
    .wds-topbar-item.wds-active {
      background: var(--primary-50);
      color: var(--primary-700);
    }
    [data-wds-layout="topnav"] .wds-sidebar-open-btn,
    [data-wds-layout="horizontal"] .wds-sidebar-open-btn,
    [data-wds-layout="topnav"] .wds-search,
    [data-wds-layout="horizontal"] .wds-search {
      display: none;
    }

    .wds-main {
      flex: 1;
      padding: 15px;
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 1em;
    }

    .wds-icon,
    .wds-icon-svg,
    .wds-icon svg {
      width: 16px;
      height: 16px;
      display: block;
      flex-shrink: 0;
    }

    .wds-avatar {
      width: 36px;
      height: 36px;
      border-radius: var(--wds-radius-full);
      background: var(--primary-200);
      color: var(--primary-800);
      font-size: 0.75rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .wds-user-menu {
      position: relative;
    }
    .wds-user-menu-trigger {
      display: flex;
      align-items: center;
      gap: 0.5em;
      padding: 0 15px;
      min-height: 40px;
      border-radius: 4px;
      color: inherit;
      cursor: pointer;
    }
    .wds-user-menu-trigger:hover {
      background: var(--wds-bg-subtle);
    }
    .wds-user-menu-name {
      font-size: 13px;
      font-weight: 600;
      white-space: nowrap;
    }
    .wds-user-menu-chevron {
      width: 14px;
      height: 14px;
      color: var(--wds-text-muted);
      opacity: 0.5;
    }
    .wds-user-menu-panel {
      display: none;
      position: absolute;
      inset-inline-end: 0;
      top: calc(100% + 0.5rem);
      min-width: 180px;
      background: var(--wds-surface);
      border: 1px solid var(--wds-border);
      border-radius: var(--wds-radius-lg);
      box-shadow: var(--wds-shadow-md);
      padding: 0.35rem;
      z-index: 60;
    }
    .wds-user-menu.wds-open .wds-user-menu-panel {
      display: flex;
      flex-direction: column;
    }
    .wds-user-menu-panel a {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.625rem;
      border-radius: var(--wds-radius);
      color: var(--wds-text-muted);
      font-size: var(--wds-text-sm);
      font-weight: 500;
    }
    .wds-user-menu-panel a:hover {
      background: var(--wds-bg-subtle);
      color: var(--wds-text);
    }

    .wds-logo-img {
      width: 28px;
      height: 28px;
      object-fit: contain;
      flex-shrink: 0;
      border-radius: var(--wds-radius);
    }
    .wds-topbar-logo .wds-logo-img {
      width: 24px;
      height: 24px;
    }

    @media (max-width: 979px) {
      .wds-sidebar { display: none; }
      [data-wds-sidebar="expanded"][data-wds-layout="sidebar"] .wds-sidebar {
        display: block;
        position: fixed;
        inset: 0 auto 0 0;
        box-shadow: 0 0 25px rgba(0, 0, 0, 0.2);
      }
    }
</style>
