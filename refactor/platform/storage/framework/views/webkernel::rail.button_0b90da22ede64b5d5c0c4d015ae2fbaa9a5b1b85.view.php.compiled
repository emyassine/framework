<?php  $__props = [
  'panel_id' => '',
  'icon' => null,
  'label' => '',
  'href' => '#',
  'active' => false,
  'logo' => '',
  'logo_shape' => 'favicon',
]; foreach ($__props as $__n => $__d) { if (!isset($$__n)) { $$__n = $__d; } } $attributes = (isset($attributes) && $attributes instanceof \Webkernel\View\AttributeBag ? $attributes : new \Webkernel\View\AttributeBag([]))->except(\array_keys($__props)); unset($__props, $__n, $__d); ?>
<?php 
  $attributes = $attributes ?? new \Webkernel\View\AttributeBag([]);
 ?>
<li class="wds-rail-item<?php echo \Webkernel\View\View::echo($active ? ' wds-active' : ''); ?>">
  <a
    href="<?php echo \Webkernel\View\View::echo($href); ?>"
    title="<?php echo \Webkernel\View\View::echo($label); ?>"
    data-wds-panel-button
    data-panel-id="<?php echo \Webkernel\View\View::echo($panel_id); ?>"
    <?php echo \Webkernel\View\View::echo($attributes); ?>

  >
    <?php if($logo !== ''): ?>
      <span class="wds-nav-logo--<?php echo \Webkernel\View\View::echo($logo_shape); ?>"><img src="<?php echo \Webkernel\View\View::echo($logo); ?>" alt="" /></span>
    <?php elseif(!empty($icon)): ?>
      <?php  $this->start_component('webkernel::icon',['name'=>$icon]); ?><?php echo $this->render_component(); ?>
    <?php endif; ?>
  </a>
</li>
