
<?php  $__props = [
  'error' => '',
  'email' => '',
]; foreach ($__props as $__n => $__d) { if (!isset($$__n)) { $$__n = $__d; } } $attributes = (isset($attributes) && $attributes instanceof \Webkernel\View\AttributeBag ? $attributes : new \Webkernel\View\AttributeBag([]))->except(\array_keys($__props)); unset($__props, $__n, $__d); ?>
<?php if ($this->once('wds.login')): ?>
<style>
.wds-login { display: flex; flex-direction: column; gap: 1rem; color: var(--wds-text); }
.wds-login-brand { display: flex; justify-content: center; margin-bottom: 0.5rem; }
.wds-login-brand img { width: 2.5rem; height: 2.5rem; object-fit: contain; }
.wds-login-title { font-size: var(--wds-text-xl); font-weight: 600; text-align: center; color: var(--wds-text); }
.wds-login-error {
  padding: 0.6rem 0.75rem;
  border-radius: var(--wds-radius);
  background: var(--danger-50);
  color: var(--danger-800);
  font-size: var(--wds-text-sm);
}
.wds-login-actions { margin-top: 0.5rem; display: flex; }
.wds-login-actions .wds-btn { width: 100%; justify-content: center; }
</style>
<?php endif; ?>
<?php 
  $logo = \function_exists('webkernel_branding_url') ? webkernel_branding_url('webkernel-favicon') : '';
 ?>
<?php  $this->start_component('webkernel::page.simple',['title'=>'Sign in']); ?>
  <form class="wds-login" method="post" action="/login">
    <?php echo \Webkernel\Csrf::field(); ?>
    <div class="wds-login-brand">
      <?php if($logo !== ''): ?>
        <img src="<?php echo \Webkernel\View\View::echo($logo); ?>" alt="" width="40" height="40" />
      <?php endif; ?>
    </div>
    <h1 class="wds-login-title">Sign in</h1>
    <?php if($error !== ''): ?>
      <p class="wds-login-error" role="alert"><?php echo \Webkernel\View\View::echo($error); ?></p>
    <?php endif; ?>
    <?php  $this->start_component('webkernel::text-input',['name'=>'email','label'=>'Email','type'=>'email','value'=>$email]); ?><?php echo $this->render_component(); ?>
    <?php  $this->start_component('webkernel::text-input',['name'=>'password','label'=>'Password','type'=>'password']); ?><?php echo $this->render_component(); ?>
    <div class="wds-login-actions">
      <?php  $this->start_component('webkernel::button',['type'=>'submit','color'=>'primary']); ?>Sign in<?php echo $this->render_component(); ?>
    </div>
  </form>
<?php echo $this->render_component(); ?>
