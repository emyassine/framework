<?php  $__props = [
  'lang' => 'en',
  'theme' => 'light',
  'layout' => 'base',
  'title' => 'Webkernel',
  'csrf' => true,
]; foreach ($__props as $__n => $__d) { if (!isset($$__n)) { $$__n = $__d; } } $attributes = (isset($attributes) && $attributes instanceof \Webkernel\View\AttributeBag ? $attributes : new \Webkernel\View\AttributeBag([]))->except(\array_keys($__props)); unset($__props, $__n, $__d); ?>
<!DOCTYPE html>
<html
  lang="<?php echo \Webkernel\View\View::echo($lang); ?>"
  data-wds-theme="<?php echo \Webkernel\View\View::echo($theme); ?>"
  data-wds-layout="<?php echo \Webkernel\View\View::echo($layout); ?>"
>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <?php if($csrf): ?>
    <?php echo \Webkernel\Csrf::meta(); ?>

  <?php endif; ?>
  <title><?php echo \Webkernel\View\View::echo($title); ?></title>
  <meta name="description" content="<?php echo \Webkernel\View\View::echo($title); ?>" />
  <?php echo $this->run_child('webkernel::layouts.partials.typography'); ?>
  <link rel="stylesheet" href="<?php echo \Webkernel\View\View::echo(\Webkernel\Platform\Wds::css_href()); ?>">
  <?php echo  $this->stack('styles'); ?>
  <?php echo  $this->stack('head'); ?>
</head>
<body>
  <?php echo $this->yield_content('content'); ?>
  <?php echo  $this->stack('scripts'); ?>
</body>
</html>
