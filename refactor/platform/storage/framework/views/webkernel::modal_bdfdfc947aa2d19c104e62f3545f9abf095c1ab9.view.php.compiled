
<?php  $__props = [
  'id' => null,
  'heading' => null,
  'description' => null,
  'icon' => null,
  'icon_color' => 'primary',
  'width' => 'sm',
  'slide_over' => false,
  'close_button' => true,
  'open' => false,
]; foreach ($__props as $__n => $__d) { if (!isset($$__n)) { $$__n = $__d; } } $attributes = (isset($attributes) && $attributes instanceof \Webkernel\View\AttributeBag ? $attributes : new \Webkernel\View\AttributeBag([]))->except(\array_keys($__props)); unset($__props, $__n, $__d); ?>
<?php 
  $attributes = $attributes ?? new \Webkernel\View\AttributeBag([]);
  $id = $id !== null && $id !== '' ? (string) $id : 'w-modal';
  $has_heading = $heading !== null && $heading !== '';
  $has_description = $description !== null && $description !== '';
  $has_icon = $icon !== null && $icon !== '';
  $has_trigger = isset($trigger) && $trigger !== '';
  $has_footer = isset($footer) && $footer !== '';
  $open_attr = $open ? 'true' : 'false';
 ?>
<div
  <?php echo \Webkernel\View\View::echo($attributes->class(['w-modal', 'w-slide-over' => $slide_over, 'w-open' => $open])); ?>

  data-w-modal
  data-modal-id="<?php echo \Webkernel\View\View::echo($id); ?>"
  data-open="<?php echo \Webkernel\View\View::echo($open_attr); ?>"
>
  <?php if($has_trigger): ?>
    <div class="w-modal-trigger" data-w-modal-trigger>
      <?php echo $trigger; ?>

    </div>
  <?php endif; ?>
  <div class="w-modal-close-overlay" data-w-modal-overlay></div>
  <div class="w-modal-window-ctn">
    <div class="w-modal-window w-width-<?php echo \Webkernel\View\View::echo($width); ?>" role="dialog" aria-modal="true" aria-labelledby="<?php echo \Webkernel\View\View::echo($id); ?>-heading">
      <?php if($close_button): ?>
        <div class="w-modal-close-btn">
          <?php  $this->start_component('webkernel::button-icon',['icon'=>'x','label'=>lang('panel.close'),'size'=>'sm','color'=>'gray','data_w_modal_close'=>true]); ?><?php echo $this->render_component(); ?>
        </div>
      <?php endif; ?>
      <?php if($has_heading || $has_icon): ?>
        <div class="w-modal-header">
          <?php if($has_icon): ?>
            <span class="w-modal-icon w-color-<?php echo \Webkernel\View\View::echo($icon_color); ?>" aria-hidden="true"><?php  $this->start_component('webkernel::icon',['name'=>$icon]); ?><?php echo $this->render_component(); ?></span>
          <?php endif; ?>
          <div>
            <?php if($has_heading): ?>
              <h2 class="w-modal-heading" id="<?php echo \Webkernel\View\View::echo($id); ?>-heading"><?php echo \Webkernel\View\View::echo($heading); ?></h2>
            <?php endif; ?>
            <?php if($has_description): ?>
              <p class="w-modal-description"><?php echo \Webkernel\View\View::echo($description); ?></p>
            <?php endif; ?>
          </div>
        </div>
      <?php endif; ?>
      <div class="w-modal-content"><?php echo $slot; ?></div>
      <?php if($has_footer): ?>
        <div class="w-modal-footer">
          <div class="w-modal-footer-actions"><?php echo $footer; ?></div>
        </div>
      <?php endif; ?>
    </div>
  </div>
</div>
