
<?php  $__props = [
  'heading' => null,
  'description' => null,
  'contained' => true,
  'compact' => false,
  'icon' => null,
]; foreach ($__props as $__n => $__d) { if (!isset($$__n)) { $$__n = $__d; } } $attributes = (isset($attributes) && $attributes instanceof \Webkernel\View\AttributeBag ? $attributes : new \Webkernel\View\AttributeBag([]))->except(\array_keys($__props)); unset($__props, $__n, $__d); ?>
<?php 
  $attributes = $attributes ?? new \Webkernel\View\AttributeBag([]);
 ?>
<section <?php echo \Webkernel\View\View::echo($attributes->class(['w-section', 'w-section-not-contained' => ! $contained, 'w-compact' => $compact])); ?>>
  <?php if(($heading !== null && $heading !== '') || ($description !== null && $description !== '') || $icon): ?>
    <header class="w-section-header">
      <?php if($icon): ?>
        <?php  $this->start_component('webkernel::icon',['name'=>$icon]); ?><?php echo $this->render_component(); ?>
      <?php endif; ?>
      <div class="w-section-header-text">
        <?php if($heading !== null && $heading !== ''): ?>
          <h2 class="w-section-heading"><?php echo \Webkernel\View\View::echo($heading); ?></h2>
        <?php endif; ?>
        <?php if($description !== null && $description !== ''): ?>
          <p class="w-section-description"><?php echo \Webkernel\View\View::echo($description); ?></p>
        <?php endif; ?>
      </div>
    </header>
  <?php endif; ?>
  <div class="w-section-content-ctn">
    <div class="w-section-body">
      <?php echo $slot; ?>

    </div>
  </div>
</section>
