<div class="w-user-menu" id="w-user-menu">
  <button type="button" class="w-user-menu-trigger" onclick="toggleUserMenu()" aria-haspopup="menu" aria-expanded="false">
    <span class="w-avatar"><?php echo \Webkernel\View\View::echo(strtoupper(substr((string) ($brand ?? 'W'), 0, 1))); ?></span>
    <span class="w-user-menu-name"><?php echo \Webkernel\View\View::echo($brand ?? 'Webkernel'); ?></span>
    <span class="w-user-menu-chevron">
      <span class="w-icon"><?php echo icon('chevron-down', 'w-icon-svg'); ?></span>
    </span>
  </button>
  <div class="w-user-menu-panel" role="menu">
    <a href="/system" role="menuitem">
      <span class="w-icon"><?php echo icon('circle-user', 'w-icon-svg'); ?></span>
      <?php echo \Webkernel\View\View::echo(lang('panel.profile')); ?>

    </a>
    <form method="post" action="/logout" role="none">
      <?php echo \Webkernel\Csrf::field(); ?>
      <button type="submit" role="menuitem">
        <span class="w-icon"><?php echo icon('log-out', 'w-icon-svg'); ?></span>
        <?php echo \Webkernel\View\View::echo(lang('panel.sign_out')); ?>

      </button>
    </form>
  </div>
</div>
