<?php  $__props = [
  'tab' => '',
  'active' => false,
  'icon' => null,
]; foreach ($__props as $__n => $__d) { if (!isset($$__n)) { $$__n = $__d; } } $attributes = (isset($attributes) && $attributes instanceof \Webkernel\View\AttributeBag ? $attributes : new \Webkernel\View\AttributeBag([]))->except(\array_keys($__props)); unset($__props, $__n, $__d); ?>
<button
  type="button"
  class="wds-tabs-item<?php echo \Webkernel\View\View::echo($active ? ' wds-active' : ''); ?>"
  role="tab"
  aria-selected="<?php echo \Webkernel\View\View::echo($active ? 'true' : 'false'); ?>"
  data-tab="<?php echo \Webkernel\View\View::echo($tab); ?>"
>
  <?php if(!empty($icon)): ?>
    <span class="wds-icon"><?php echo icon((string) $icon, 'wds-icon-svg'); ?></span>
  <?php endif; ?>
  <span><?php echo \Webkernel\View\View::echo($slot); ?></span>
</button>
