<?php $_shouldextend[1]=1; ?>

<?php $this->start_section('title', lang('panel.manage')); ?>

<?php $this->start_section('breadcrumb'); ?>
  <?php echo \Webkernel\View\View::echo($panel['label'] ?? ''); ?> / <?php echo \Webkernel\View\View::echo(lang('panel.manage')); ?>

<?php $this->stop_section(); ?>

<?php $this->start_section('content'); ?>
  <?php  $this->start_component('webkernel::page',['title'=>lang('panel.manage'),'description'=>lang('panel.manage_help')]); ?>
    <?php if(!empty($saved)): ?>
      <p class="wds-flash"><?php echo \Webkernel\View\View::echo(lang('panel.saved')); ?></p>
    <?php endif; ?>
    <form class="wds-form" method="post" action="">
      <?php echo \Webkernel\Csrf::field(); ?>

      <div class="wds-form-row">
        <label for="panel-logo"><?php echo \Webkernel\View\View::echo(lang('panel.logo')); ?></label>
        <input id="panel-logo" type="url" name="logo" value="<?php echo \Webkernel\View\View::echo($logo); ?>" placeholder="https://" />
      </div>
      <div class="wds-form-row">
        <label for="panel-logo-shape"><?php echo \Webkernel\View\View::echo(lang('panel.logo_shape')); ?></label>
        <select id="panel-logo-shape" name="logo_shape">
          <option value="favicon"<?php echo \Webkernel\View\View::echo(($logo_shape ?? '') === 'favicon' ? ' selected' : ''); ?>><?php echo \Webkernel\View\View::echo(lang('panel.logo_shape_favicon')); ?></option>
          <option value="round"<?php echo \Webkernel\View\View::echo(($logo_shape ?? '') === 'round' ? ' selected' : ''); ?>><?php echo \Webkernel\View\View::echo(lang('panel.logo_shape_round')); ?></option>
          <option value="square"<?php echo \Webkernel\View\View::echo(($logo_shape ?? '') === 'square' ? ' selected' : ''); ?>><?php echo \Webkernel\View\View::echo(lang('panel.logo_shape_square')); ?></option>
        </select>
      </div>
      <div class="wds-form-actions">
        <?php  $this->start_component('webkernel::button',['type'=>'submit','color'=>'primary']); ?><?php echo \Webkernel\View\View::echo(lang('panel.save')); ?><?php echo $this->render_component(); ?>
      </div>
    </form>
  <?php echo $this->render_component(); ?>
<?php $this->stop_section(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->run_child('webkernel::layouts.page'); } ?>