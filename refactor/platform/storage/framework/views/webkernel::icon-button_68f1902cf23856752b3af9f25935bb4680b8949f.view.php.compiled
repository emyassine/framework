
<?php  $__props = [
  'icon' => null,
  'label' => null,
  'color' => 'gray',
  'size' => 'md',
  'href' => null,
  'tag' => 'button',
  'type' => 'button',
  'disabled' => false,
  'tooltip' => null,
  'badge' => null,
  'badge_color' => 'primary',
]; foreach ($__props as $__n => $__d) { if (!isset($$__n)) { $$__n = $__d; } } $attributes = (isset($attributes) && $attributes instanceof \Webkernel\View\AttributeBag ? $attributes : new \Webkernel\View\AttributeBag([]))->except(\array_keys($__props)); unset($__props, $__n, $__d); ?>
<?php 
  $attributes = $attributes ?? new \Webkernel\View\AttributeBag([]);
  $size = $size instanceof \Webkernel\Platform\Components\Size ? $size->value : (string) $size;
  $tag = $tag === 'a' || ($href !== null && $href !== '') ? 'a' : 'button';
  $title = $tooltip ?? $label;
 ?>
<?php if ($this->once('wds.icon-btn')): ?>
<style>
.wds-icon-btn {
  position: relative;
  display: inline-flex; align-items: center; justify-content: center;
  width: 2.25rem; height: 2.25rem;
  border-radius: var(--wds-radius-lg);
  color: var(--wds-text-muted);
  background: transparent;
  transition: color var(--wds-transition), background var(--wds-transition);
  outline: none;
}
.wds-icon-btn:hover { color: var(--wds-text); background: var(--wds-bg-subtle); }
.wds-icon-btn:focus-visible { box-shadow: 0 0 0 2px var(--primary-600); }
.wds-icon-btn svg, .wds-icon-btn .wds-icon { width: 1rem; height: 1rem; }
.wds-icon-btn.wds-size-xs { width: 1.75rem; height: 1.75rem; }
.wds-icon-btn.wds-size-sm { width: 2rem; height: 2rem; }
.wds-icon-btn.wds-size-lg { width: 2.5rem; height: 2.5rem; }
.wds-icon-btn.wds-size-xl { width: 2.75rem; height: 2.75rem; }
.wds-icon-btn.wds-color-primary { color: var(--primary-600); }
.wds-icon-btn.wds-color-danger { color: var(--danger-600); }
.wds-icon-btn.wds-color-success { color: var(--success-600); }
.wds-icon-btn.wds-color-warning { color: var(--warning-700); }
.wds-icon-btn.wds-color-info { color: var(--info-600); }
.wds-icon-btn.wds-disabled, .wds-icon-btn[disabled] { opacity: 0.7; pointer-events: none; cursor: default; }
.wds-icon-btn-badge {
  position: absolute; inset-inline-start: 100%; top: 0;
  transform: translate(-50%, -50%); z-index: 1;
}
[dir="rtl"] .wds-icon-btn-badge { transform: translate(50%, -50%); }
a.wds-icon-btn { text-decoration: none; color: inherit; }
</style>
<?php endif; ?>
<<?php echo \Webkernel\View\View::echo($tag); ?>

  <?php if($tag === 'a' && $href && ! $disabled): ?>
    href="<?php echo \Webkernel\View\View::echo($href); ?>"
  <?php endif; ?>
  <?php if($tag === 'button'): ?>
    type="<?php echo \Webkernel\View\View::echo($type); ?>"
  <?php endif; ?>
  <?php if($disabled): ?> disabled aria-disabled="true" <?php endif; ?>
  <?php if($title): ?> title="<?php echo \Webkernel\View\View::echo($title); ?>" <?php endif; ?>
  <?php if($label): ?> aria-label="<?php echo \Webkernel\View\View::echo($label); ?>" <?php endif; ?>
  <?php echo \Webkernel\View\View::echo($attributes->class([
    'wds-icon-btn',
    'wds-color-'.$color,
    'wds-size-'.$size,
    'wds-disabled' => $disabled,
  ])); ?>

>
  <?php if($icon): ?>
    <?php  $this->start_component('webkernel::icon',['name'=>$icon]); ?><?php echo $this->render_component(); ?>
  <?php endif; ?>
  <?php echo $slot; ?>

  <?php if($badge !== null && $badge !== ''): ?>
    <span class="wds-icon-btn-badge">
      <?php  $this->start_component('webkernel::badge',['color'=>$badge_color,'size'=>'xs']); ?><?php echo \Webkernel\View\View::echo($badge); ?><?php echo $this->render_component(); ?>
    </span>
  <?php endif; ?>
</<?php echo \Webkernel\View\View::echo($tag); ?>>
