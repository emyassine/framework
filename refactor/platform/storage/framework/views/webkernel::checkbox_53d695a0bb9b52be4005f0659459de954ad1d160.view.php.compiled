
<?php  $__props = [
  'name' => '',
  'value' => '1',
  'checked' => false,
  'disabled' => false,
  'valid' => true,
  'label' => null,
]; foreach ($__props as $__n => $__d) { if (!isset($$__n)) { $$__n = $__d; } } $attributes = (isset($attributes) && $attributes instanceof \Webkernel\View\AttributeBag ? $attributes : new \Webkernel\View\AttributeBag([]))->except(\array_keys($__props)); unset($__props, $__n, $__d); ?>
<?php 
  $attributes = $attributes ?? new \Webkernel\View\AttributeBag([]);
 ?>
<label class="w-checkbox-wrap">
  <input
    type="checkbox"
    name="<?php echo \Webkernel\View\View::echo($name); ?>"
    value="<?php echo \Webkernel\View\View::echo($value); ?>"
    <?php if($checked): ?> checked <?php endif; ?>
    <?php if($disabled): ?> disabled <?php endif; ?>
    <?php echo \Webkernel\View\View::echo($attributes->class([
      'w-checkbox-input',
      'w-invalid' => ! $valid,
    ])); ?>

  />
  <?php if($label !== null && $label !== ''): ?>
    <span><?php echo \Webkernel\View\View::echo($label); ?></span>
  <?php endif; ?>
  <?php echo $slot; ?>

</label>
