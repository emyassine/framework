    "name": "webkernel/http",
    "description": "HTTP request and PSR-7 adapters.",
    "type": "library",
    "license": "proprietary",
    "version": "0.12.0",
    "require": {
        "php": ">=8.4"
    },
    "autoload": {
        "psr-4": {
            "Webkernel\\Http\\": "src/"
        }
    },
    "extra": {
