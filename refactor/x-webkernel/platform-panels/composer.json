{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "webkernel/panels",
    "description": "Webkernel admin: Panel, Resource, Page, Table.",
    "version": "0.12.0",
    "type": "webkernel-stdlib",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "webkernel/actions": "^0.12.0",
        "webkernel/auth": "^0.12.0",
        "webkernel/codebase": "^0.12.0",
        "webkernel/components": "^0.12.0",
        "webkernel/schemas": "^0.12.0"
    },
    "autoload": {
        "psr-4": {
            "Webkernel\\Platform\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webkernel\\Platform\\Tests\\": "tests/"
        }
    },
    "extra": {
        "webkernel": {
            "package_repo": "git@github.com:webkernelphp/panels.git",
            "production": true,
            "provider": "Webkernel\\Platform\\PanelsProvider",
            "prefix": "webkernel"
        }
    },
    "config": {
        "sort-packages": true
    }
}
