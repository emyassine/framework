{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "webkernel/tables",
    "description": "Webkernel tables: list columns, filters, and bulk actions.",
    "version": "0.12.0",
    "type": "webkernel-stdlib",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "webkernel/codebase": "^0.12.0",
        "webkernel/components": "^0.12.0",
        "webkernel/actions": "^0.12.0"
    },
    "autoload": {
        "psr-4": {
            "Webkernel\\Platform\\Tables\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webkernel\\Platform\\Tables\\Tests\\": "tests/"
        }
    },
    "extra": {
        "webkernel": {
            "package_repo": "git@github.com:webkernelphp/tables.git",
            "production": true,
            "prefix": "tables"
        }
    },
    "config": {
        "sort-packages": true
    }
}
