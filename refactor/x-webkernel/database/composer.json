{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "webkernel/database",
    "description": "Webkernel database: connections, query, schema, migrations. Drivers: sqlite, mysql, pgsql. ClickHouse later.",
    "version": "0.12.0",
    "type": "webkernel-stdlib",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "ext-pdo": "*",
        "webkernel/codebase": "^0.12.0"
    },
    "autoload": {
        "psr-4": {
            "Webkernel\\Database\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webkernel\\Database\\Tests\\": "tests/"
        }
    },
    "extra": {
        "webkernel": {
            "package_repo": "git@github.com:webkernelphp/database.git",
            "production": true,
            "provider": "Webkernel\\Database\\DatabaseProvider",
            "prefix": "database"
        }
    },
    "config": {
        "sort-packages": true
    }
}
