{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "webkernel/components",
    "description": "Webkernel UI atoms: views plus dumpable PHP declarations.",
    "version": "0.12.0",
    "type": "webkernel-component",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "webkernel/codebase": "^0.12.0"
    },
    "autoload": {
        "psr-4": {
            "Webkernel\\Platform\\Components\\": "src/",
            "Webkernel\\Platform\\Colors\\": "src/Colors/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webkernel\\Platform\\Components\\Tests\\": "tests/"
        }
    },
    "extra": {
        "webkernel": {
            "package_repo": "git@github.com:webkernelphp/components.git",
            "production": true,
            "provider": "Webkernel\\Platform\\Components\\ComponentsProvider",
            "prefix": "webkernel"
        }
    },
    "config": {
        "sort-packages": true
    }
}
