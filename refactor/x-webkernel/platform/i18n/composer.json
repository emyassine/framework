{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "webkernel/i18n",
    "description": "Webkernel i18n: fast_i18n, locale context, translation catalog from LANG_PATH.",
    "version": "0.12.0",
    "type": "webkernel-stdlib",
    "license": "EPL-2.0",
    "authors": [
        {
            "name": "El Moumen Yassine",
            "email": "yassine@numerimondes.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-intl": "*",
        "webkernel/codebase": "^0.12.0"
    },
    "autoload": {
        "psr-4": {
            "Webkernel\\I18n\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webkernel\\I18n\\Tests\\": "tests/"
        }
    },
    "extra": {
        "webkernel": {
            "package_repo": "git@github.com:webkernelphp/i18n.git",
            "production": true,
            "provider": "Webkernel\\I18n\\I18nProvider",
            "prefix": "i18n"
        }
    },
    "config": {
        "sort-packages": true
    }
}
