{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "webkernel/container",
    "description": "Webkernel standalone dependency injection container with module isolation and runtime inspection.",
    "version": "0.12.0",
    "homepage": "https://www.webkernelphp.com",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "El Moumen Yassine",
            "email": "yassine@numerimondes.com",
            "homepage": "https://webkernelphp.com/about"
        }
    ],
    "require": {
        "php": ">=8.5"
    },
    "autoload": {
        "psr-4": {
            "Webkernel\\Container\\": "src/",
            "Webkernel\\Contracts\\": "src/Contracts/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webkernel\\Container\\Tests\\": "tests/"
        }
    },
    "extra": {
        "webkernel": {
            "$schema": "https://webkernelphp.org/packages/v1/schema.json",
            "provider": "",
            "x-monorepo": {
                "package-repos": [
                    "git@github.com:webkernelphp/container.git"
                ]
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
