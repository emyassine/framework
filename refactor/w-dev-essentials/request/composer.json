{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "webkernel/request",
    "description": "Webkernel request envelope and CSRF helpers.",
    "version": "0.12.0",
    "homepage": "https://www.webkernelphp.com",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "psr/http-message": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Webkernel\\Request\\": "src/"
        },
        "classmap": [
            "classmap/Csrf.php",
            "classmap/Request.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
