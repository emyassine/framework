{
    "name": "webkernel/webkernel",
    "description": "The Webkernel Platform",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "webkernel",
            "email": "platform@webkernelphp.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Modules\\": "modules/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "vendor-dir": "platform/dependencies/packagist",
        "apcu-autoloader": true,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "php-http/discovery": true,
            "webkernel/lifecycle": true
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "x-webkernel/*",
            "options": {
                "symlink": true
            }
        }
    ],
	"require": {
	    "php": ">8.4",
	    "ext-dom": "*",
	    "ext-fileinfo": "*",
	    "ext-intl": "*",
	    "ext-libxml": "*",
	    "ext-mbstring": "*",
	    "ext-pdo": "*",
	    "ext-readline": "*",
	    "ext-simplexml": "*",
	    "psr/cache": "^3.0",
	    "psr/clock": "^1.0",
	    "psr/container": "^2.0",
	    "psr/http-client": "^1.0",
	    "psr/http-factory": "^1.0",
	    "psr/http-message": "^1.0 || ^2.0",
	    "psr/log": "^3.0",
	    "psr/simple-cache": "^3.0",
	    "webkernel/codebase": "^0.12.0"
	},
	"scripts": {
		"dump-autoload" : "composer dump-autoload -o"
	}
}
