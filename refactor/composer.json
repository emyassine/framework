{
    "name": "webkernel/webkernel",
    "description": "The Webkernel Platform",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "webkernel",
            "email": "platform@webkernelphp.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Modules\\": "modules/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webkernel\\Tests\\": "x-webkernel/codebase/tests/",
            "Webkernel\\Imagery\\Tests\\": "x-webkernel/platform/imagery/tests/",
            "Webkernel\\I18n\\Tests\\": "x-webkernel/platform/i18n/tests/",
            "Webkernel\\Lifecycle\\Tests\\": "x-webkernel/lifecycle/tests/",
            "Webkernel\\Platform\\Components\\Tests\\": "x-webkernel/platform/components/tests/",
            "Webkernel\\Platform\\Schemas\\Tests\\": "x-webkernel/platform/schemas/tests/",
            "Webkernel\\Platform\\Tests\\": "x-webkernel/platform/panels/tests/",
            "Webkernel\\System\\Tests\\": "x-webkernel/system/tests/",
            "Webkernel\\DevTools\\Tests\\": "x-webkernel/devtools/tests/",
            "Webkernel\\Database\\Tests\\": "x-webkernel/database/tests/",
            "Webkernel\\Models\\Tests\\": "x-webkernel/models/tests/",
            "Webkernel\\Auth\\Tests\\": "x-webkernel/auth/tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "vendor-dir": "platform/dependencies/packagist",
        "apcu-autoloader": true,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "php-http/discovery": true,
            "webkernel/lifecycle": true
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "x-webkernel/*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "x-webkernel/platform/*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "modules/*/*",
            "options": {
                "symlink": true
            }
        }
    ],
	"require": {
	    "php": ">=8.5",
	    "acme/billing": "*",
	    "webkernel/codebase": "^0.12.0"
	},
	"require-dev": {
        "phpunit/phpunit": "^11.5",
        "webkernel/devtools": "^0.12.0"
    },
    "scripts": {
	        "dump-autoload": ["composer dump-autoload -o",
	        "composer dump-autoload --optimize --classmap-authoritative"
        ],
    		"test": "phpunit"
	}
}
