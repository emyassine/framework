{
    "name": "webkernel/webkernel",
    "description": "The Webkernel Platform",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "webkernel",
            "email": "platform@webkernelphp.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "vendor-dir": "platform/dependencies/packagist",
        "apcu-autoloader": true,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "php-http/discovery": true,
            "webkernel/lifecycle": true
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "x-webkernel/*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "x-modules/*/*",
            "options": {
                "symlink": true
            }
        }
    ],
	"require": {
	    "php": ">=8.5",
	    "acme/billing": "*",
	    "webkernel/codebase": "^0.12.0"
	},
	"require-dev": {
        "phpunit/phpunit": "^11.5",
        "webkernel/devtools": "^0.12.0"
    },
    "scripts": {
	        "dump-autoload": ["composer dump-autoload -o",
	        "composer dump-autoload --optimize --classmap-authoritative"
        ],
    		"test": "phpunit"
	}
}
