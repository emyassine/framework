{
  "name": "webkernel/lifecycle",
  "description": "Webkernel Composer plugin — custom installer, lifecycle hooks, and action-based code generation.",
  "type": "composer-plugin",
  "license": "proprietary",
  "version": "0.12.0",
  "authors": [
    {
      "name": "El Moumen Yassine",
      "email": "yassine@numerimondes.com",
      "role": "Author"
    }
  ],
  "require": {
    "php": ">=8.5",
    "composer-plugin-api": "^2.0",
    "composer/installers": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Webkernel\\Lifecycle\\": "src/"
    },
    "files": [
      "load.lifecycle.functions.php"
    ]
  },
  "extra": {
    "class": "Webkernel\\Lifecycle\\LCInstaller",
    "webkernel": {
      "$schema": "./_schemas/schema.v1.json",
      "lifecycle": {
        "checks": [
          {
            "check": "PHP_VERSION_ID < 80500",
            "on-fail": { "type": "danger", "message": "PHP >= 8.5 is required." },
            "fix": "sudo apt install php8.5"
          }
        ],
        "events": {
          "post-autoload-dump": "Webkernel\\Lifecycle\\ComposerScripts::post_autoload_dump",
          "pre-install-cmd":    "Webkernel\\Lifecycle\\ComposerScripts::pre_install_cmd",
          "pre-update-cmd":     "Webkernel\\Lifecycle\\ComposerScripts::pre_update_cmd"
        },
        "actions": []
      }
    }
  },
  "config": {
    "allow-plugins": {
      "webkernel/lifecycle": true
    }
  }
}
