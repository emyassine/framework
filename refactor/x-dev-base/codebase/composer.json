{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "webkernel/codebase",
    "description": "Webkernel runtime: config, route, view, console, HTTP door.",
    "type": "library",
    "license": "proprietary",
    "version": "0.12.0",
    "autoload": {
        "files": [
            "namespacer.php"
        ],
        "psr-4": {
            "Webkernel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webkernel\\Tests\\": "tests/"
        }
    },
    "require": {
    		"php": ">=8.5",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-intl": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-readline": "*",
        "ext-simplexml": "*",
        "phpmailer/phpmailer": "^6.10",
        "psr/cache": "^3.0",
        "psr/clock": "^1.0",
        "psr/container": "^2.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0",
        "webkernel/config": "self.version",
        "webkernel/commands": "self.version",
        "webkernel/composables": "self.version",
        "webkernel/console": "self.version",
        "webkernel/lifecycle": "self.version"
    },
    "extra": {
        "webkernel": {
            "package": {
                "provider": "Webkernel\\CodebaseProvider",
                "post-autoload-dump": "Webkernel\\Commands\\DumpAutoloadCommand"
            },
            "x-monorepo": {
                "package-repo": "git@github.com:webkernelphp/codebase.git"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
