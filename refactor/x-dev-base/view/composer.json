{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "webkernel/view",
    "description": "Webkernel view engine.",
    "version": "0.12.0",
    "homepage": "https://www.webkernelphp.com",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "webkernel/composables": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Webkernel\\View\\": "src/"
        },
        "files": [
            "load.view.function.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
