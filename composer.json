{
    "name": "webkernel/webkernel",
    "description": "The Webkernel Platform",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "webkernel",
            "email": "platform@webkernelphp.com"
        }
    ],
    "autoload": {
        "psr-4": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">8.4",
        "webkernel/codebase": "^0.12.0"
    },
    "config": {
        "vendor-dir": "third_party",
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "php-http/discovery": true,
            "webkernel/lifecycle": true
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "x-webkernel/*",
            "options": {
                "symlink": true
            }
        }
    ]
}
