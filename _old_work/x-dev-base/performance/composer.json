{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "webkernel/performance",
    "description": "Webkernel performance inspection and preferences.",
    "version": "0.12.0",
    "homepage": "https://www.webkernelphp.com",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "webkernel/composables": "self.version",
        "webkernel/paths": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Webkernel\\Performance\\": "src/Performance/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
