{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "webkernel/typography",
    "description": "Webkernel typography system.",
    "version": "0.12.0",
    "homepage": "https://www.webkernelphp.com",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.5"
    },
    "autoload": {
        "psr-4": {
            "Webkernel\\Typography\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
