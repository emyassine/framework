{
	"$schema": "https://getcomposer.org/schema.json",
  "name": "webkernel/webkernel",
  "description": "The Webkernel Platform",
  "type": "project",
  "license": "proprietary",
  "authors": [
    {
      "name": "webkernel",
      "email": "platform@webkernelphp.com"
    },
    {
      "name": "El Moumen Yassine",
      "email": "yassine@webkernel.numerimondes.com"
    }
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "vendor-dir": "internal/dependencies/packagist",
    "apcu-autoloader": true,
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "classmap-authoritative": true,
    "discard-changes": true,
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true,
      "php-http/discovery": true,
      "webkernel/lifecycle": true
    }
  },
  "repositories": [
	  {
	    "type": "path",
	    "url": "x-dev-base/*",
	    "options": {
	      "symlink": true
	    }
	  },
    {
      "type": "path",
      "url": "y-dev-platform/*",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "z-modules/*/*",
      "options": {
        "symlink": true
      }
    }
  ],
  "require": {
    "php": ">=8.5",
    "webkernel/codebase": "^0.12.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "webkernel/devtools": "^0.12.0"
  },
  "scripts": {
    "post-autoload-dump": [],
    "test": "phpunit"
  }
}
