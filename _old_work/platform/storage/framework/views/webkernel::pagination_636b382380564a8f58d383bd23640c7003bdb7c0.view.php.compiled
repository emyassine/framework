
<?php  $__props = [
  'current' => 1,
  'last' => 1,
  'total' => null,
  'from' => null,
  'to' => null,
  'simple' => false,
  'prev_href' => null,
  'next_href' => null,
]; foreach ($__props as $__n => $__d) { if (!isset($$__n)) { $$__n = $__d; } } $attributes = (isset($attributes) && $attributes instanceof \Webkernel\View\AttributeBag ? $attributes : new \Webkernel\View\AttributeBag([]))->except(\array_keys($__props)); unset($__props, $__n, $__d); ?>
<?php 
  $attributes = $attributes ?? new \Webkernel\View\AttributeBag([]);
  $current = \max(1, (int) $current);
  $last = \max(1, (int) $last);
  $is_simple = (bool) $simple;
  $pages = [];
  if (! $is_simple && $last > 1) {
    $start = \max(1, $current - 2);
    $end = \min($last, $current + 2);
    if ($start > 1) {
      $pages[] = 1;
      if ($start > 2) {
        $pages[] = null;
      }
    }
    for ($i = $start; $i <= $end; $i++) {
      $pages[] = $i;
    }
    if ($end < $last) {
      if ($end < $last - 1) {
        $pages[] = null;
      }
      $pages[] = $last;
    }
  }
  $from = $from !== null ? (int) $from : null;
  $to = $to !== null ? (int) $to : null;
  $total = $total !== null ? (int) $total : null;
 ?>
<nav <?php echo \Webkernel\View\View::echo($attributes->class(['w-pagination', 'w-simple' => $is_simple])->merge(['aria-label' => lang('panel.pagination')])); ?>>
  <?php if($current > 1): ?>
    <?php  $this->start_component('webkernel::button',['color'=>'gray','size'=>'sm','href'=>$prev_href,'class'=>'w-pagination-previous']); ?><?php echo \Webkernel\View\View::echo(lang('panel.pagination_previous')); ?><?php echo $this->render_component(); ?>
  <?php endif; ?>
  <?php if($from !== null && $to !== null && $total !== null): ?>
    <span class="w-pagination-overview"><?php echo \Webkernel\View\View::echo($from); ?>–<?php echo \Webkernel\View\View::echo($to); ?> / <?php echo \Webkernel\View\View::echo($total); ?></span>
  <?php endif; ?>
  <?php if($pages !== []): ?>
    <ol class="w-pagination-items">
      <?php foreach($pages as $page): ?>
        <?php if($page === null): ?>
          <?php  $this->start_component('webkernel::pagination.item',['disabled'=>true,'label'=>'…']); ?><?php echo $this->render_component(); ?>
        <?php else: ?>
          <?php  $this->start_component('webkernel::pagination.item',['active'=>$page === $current,'label'=>(string) $page]); ?><?php echo $this->render_component(); ?>
        <?php endif; ?>
      <?php endforeach; ?>
    </ol>
  <?php endif; ?>
  <?php if($current < $last): ?>
    <?php  $this->start_component('webkernel::button',['color'=>'gray','size'=>'sm','href'=>$next_href,'class'=>'w-pagination-next']); ?><?php echo \Webkernel\View\View::echo(lang('panel.pagination_next')); ?><?php echo $this->render_component(); ?>
  <?php endif; ?>
</nav>
