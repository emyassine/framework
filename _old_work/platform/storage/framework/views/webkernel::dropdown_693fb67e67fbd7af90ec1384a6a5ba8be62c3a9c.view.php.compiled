
<?php  $__props = [
  'placement' => 'bottom-end',
  'width' => null,
]; foreach ($__props as $__n => $__d) { if (!isset($$__n)) { $$__n = $__d; } } $attributes = (isset($attributes) && $attributes instanceof \Webkernel\View\AttributeBag ? $attributes : new \Webkernel\View\AttributeBag([]))->except(\array_keys($__props)); unset($__props, $__n, $__d); ?>
<?php 
  $attributes = $attributes ?? new \Webkernel\View\AttributeBag([]);
 ?>
<div <?php echo \Webkernel\View\View::echo($attributes->class('w-dropdown')); ?> data-w-dropdown data-placement="<?php echo \Webkernel\View\View::echo($placement); ?>">
  <div class="w-dropdown-trigger" data-w-dropdown-trigger>
    <?php echo $trigger ?? ''; ?>

  </div>
  <div class="w-dropdown-panel<?php echo \Webkernel\View\View::echo($width ? ' w-width-'.$width : ''); ?>" data-w-dropdown-panel>
