
<?php  $__props = [
  'heading' => '',
  'description' => null,
  'icon' => null,
  'icon_color' => 'primary',
  'compact' => false,
  'contained' => true,
  'heading_tag' => 'h2',
]; foreach ($__props as $__n => $__d) { if (!isset($$__n)) { $$__n = $__d; } } $attributes = (isset($attributes) && $attributes instanceof \Webkernel\View\AttributeBag ? $attributes : new \Webkernel\View\AttributeBag([]))->except(\array_keys($__props)); unset($__props, $__n, $__d); ?>
<?php 
  $attributes = $attributes ?? new \Webkernel\View\AttributeBag([]);
  $has_description = $description !== null && $description !== '';
  $has_icon = $icon !== null && $icon !== '';
  $slot = $slot ?? '';
 ?>
<div <?php echo \Webkernel\View\View::echo($attributes->class([
  'w-empty-state',
  'w-compact' => $compact,
  'w-empty-state-not-contained' => ! $contained,
])); ?>>
  <div class="w-empty-state-content">
    <?php if($has_icon): ?>
      <div class="w-empty-state-icon w-color-<?php echo \Webkernel\View\View::echo($icon_color); ?>">
        <?php  $this->start_component('webkernel::icon',['name'=>$icon]); ?><?php echo $this->render_component(); ?>
      </div>
    <?php endif; ?>
    <div class="w-empty-state-text">
      <<?php echo \Webkernel\View\View::echo($heading_tag); ?> class="w-empty-state-heading"><?php echo \Webkernel\View\View::echo($heading); ?></<?php echo \Webkernel\View\View::echo($heading_tag); ?>>
      <?php if($has_description): ?>
        <p class="w-empty-state-description"><?php echo \Webkernel\View\View::echo($description); ?></p>
      <?php endif; ?>
      <?php if($slot !== ''): ?>
        <footer class="w-empty-state-footer"><?php echo $slot; ?></footer>
      <?php endif; ?>
    </div>
  </div>
</div>
