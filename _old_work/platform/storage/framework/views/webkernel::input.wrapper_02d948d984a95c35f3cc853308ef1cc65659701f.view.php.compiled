
<?php  $__props = [
  'disabled' => false,
  'valid' => true,
  'prefix' => null,
  'prefix_icon' => null,
  'suffix' => null,
  'suffix_icon' => null,
  'inline_prefix' => false,
  'inline_suffix' => false,
]; foreach ($__props as $__n => $__d) { if (!isset($$__n)) { $$__n = $__d; } } $attributes = (isset($attributes) && $attributes instanceof \Webkernel\View\AttributeBag ? $attributes : new \Webkernel\View\AttributeBag([]))->except(\array_keys($__props)); unset($__props, $__n, $__d); ?>
<?php 
  $attributes = $attributes ?? new \Webkernel\View\AttributeBag([]);
  $has_prefix = ($prefix !== null && $prefix !== '') || ($prefix_icon !== null && $prefix_icon !== '');
  $has_suffix = ($suffix !== null && $suffix !== '') || ($suffix_icon !== null && $suffix_icon !== '');
 ?>
<div <?php echo \Webkernel\View\View::echo($attributes->class([
  'w-input-wrp',
  'w-disabled' => $disabled,
  'w-invalid' => ! $valid,
])); ?>>
  <?php if($has_prefix): ?>
    <div class="w-input-wrp-prefix<?php echo \Webkernel\View\View::echo($inline_prefix ? ' w-inline' : ''); ?>">
      <?php if($prefix_icon): ?>
        <?php  $this->start_component('webkernel::icon',['name'=>$prefix_icon]); ?><?php echo $this->render_component(); ?>
      <?php endif; ?>
      <?php if($prefix !== null && $prefix !== ''): ?>
        <span class="w-input-wrp-label"><?php echo \Webkernel\View\View::echo($prefix); ?></span>
      <?php endif; ?>
    </div>
  <?php endif; ?>
  <div class="w-input-wrp-content"><?php echo $slot; ?></div>
  <?php if($has_suffix): ?>
    <div class="w-input-wrp-suffix<?php echo \Webkernel\View\View::echo($inline_suffix ? ' w-inline' : ''); ?>">
      <?php if($suffix !== null && $suffix !== ''): ?>
        <span class="w-input-wrp-label"><?php echo \Webkernel\View\View::echo($suffix); ?></span>
      <?php endif; ?>
      <?php if($suffix_icon): ?>
        <?php  $this->start_component('webkernel::icon',['name'=>$suffix_icon]); ?><?php echo $this->render_component(); ?>
      <?php endif; ?>
    </div>
  <?php endif; ?>
</div>
