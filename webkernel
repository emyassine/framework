#!/usr/bin/env php
<?php declare(strict_types=1);

if (PHP_SAPI === 'cli-server') {
    $parsed = parse_url($_SERVER['REQUEST_URI'] ?? '/', PHP_URL_PATH);
    $uri = urldecode(is_string($parsed) && $parsed !== '' ? $parsed : '/');
    $docroot = $_SERVER['DOCUMENT_ROOT'] ?? __DIR__.'/public';
    $file = $docroot.$uri;

    if ($uri !== '/' && is_file($file)) {
        return false;
    }

    require $docroot.'/index.php';

    $status = http_response_code();
    if (!is_int($status) || $status < 100) {
        $status = 200;
    }

    $client = ($_SERVER['REMOTE_ADDR'] ?? '127.0.0.1').':'.($_SERVER['REMOTE_PORT'] ?? '0');
    $method = $_SERVER['REQUEST_METHOD'] ?? 'GET';
    $path   = $_SERVER['REQUEST_URI'] ?? $uri;
    $now = hrtime(true);
    $bits = [];
    if (defined('START_REQUEST')) {
        $bits[] = sprintf('render=%.2f', ($now - START_REQUEST) / 1e6);
        if (defined('WEBKERNEL_T_AUTOLOAD')) {
            $bits[] = sprintf('autoload=%.2f', (WEBKERNEL_T_AUTOLOAD - START_REQUEST) / 1e6);
            $bits[] = sprintf('app=%.2f', ($now - WEBKERNEL_T_AUTOLOAD) / 1e6);
        }
    }

    file_put_contents('php://stderr', sprintf(
        "%s [%d]: %s %s%s\n",
        $client,
        $status,
        $method,
        $path,
        $bits === [] ? '' : ' '.implode(' ', $bits),
    ));
    return;
}

