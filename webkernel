            'name' => $route['name'] !== '' ? $route['name'] : '-',
            'action' => $route['action'],
        ];
        $method_w = max($method_w, strlen($methods));
        $uri_w = max($uri_w, strlen($rows[array_key_last($rows)]['uri']));
        $name_w = max($name_w, strlen($rows[array_key_last($rows)]['name']));
        $action_w = max($action_w, strlen($route['action']));
    }

    echo "\n";
    echo '  '.UI::muted(sprintf('%-'.$method_w.'s  %-'.$uri_w.'s  %-'.$name_w.'s  %s', 'METHOD', 'URI', 'NAME', 'ACTION'))."\n";
    echo '  '.UI::muted(str_repeat('-', $method_w + $uri_w + $name_w + $action_w + 6))."\n";
    foreach ($rows as $row) {
        echo sprintf(
            "  %s%-{$method_w}s%s  %s%-{$uri_w}s%s  %-{$name_w}s  %s\n",
